---
import Layout from "@/layouts/Layout.astro";
import AdminNavbar from "@/components/admin/AdminNavbar.astro";
import { db } from "db";
import { brands, store } from "db/schema";
import { asc, eq } from "drizzle-orm";
import { Button } from "@/components/ui/button";
import { Label } from "@/components/ui/label";
import { Textarea } from "@/components/ui/textarea";
import { Input } from "@/components/ui/input";
import { writeFile } from "fs/promises";
import path from "path";
import { max } from "drizzle-orm";
import BrandsTable from "@/components/admin/BrandsTable";

const { locale } = Astro.params;
const logoItems = await db.select().from(brands).orderBy(asc(brands.order));
const items = logoItems.map((item) => ({
  id: item.id,
  name: item.logo?.split(".")[0] || "",
  slug: item.id.toString(),
}));
const res = await db.select().from(store).where(eq(store.section, "brands"));

const dict = res.reduce(
  (acc, cur) => {
    acc[cur.key as string] = cur.value as string;
    return acc;
  },
  {} as Record<string, string>
);

if (Astro.request.method === "POST") {
  try {
    const formData = await Astro.request.formData();

    // Handle file upload
    const files = formData.getAll("file") as File[];
    if (files && files.length > 0) {
      const maxOrderResult = await db
        .select({ maxOrder: max(brands.order) })
        .from(brands);
      let newOrder = (maxOrderResult[0]?.maxOrder ?? 0) + 1;

      for (const file of files) {
        if (file.name) {
          const buffer = Buffer.from(await file.arrayBuffer());
          await writeFile(
            path.join("./public/assets/brands", file.name),
            buffer
          );

          await db.insert(brands).values({ logo: file.name, order: newOrder });
          newOrder++;
        }
      }
    }

    // Handle store updates
    for (const [key, value] of formData.entries()) {
      if (key !== "file") {
        const existing = await db
          .select()
          .from(store)
          .where(eq(store.key, key as string))
          .limit(1);

        if (existing.length > 0) {
          await db
            .update(store)
            .set({ value: value as string })
            .where(eq(store.key, key as string));
        } else {
          await db.insert(store).values({
            section: "brands",
            key: key as string,
            value: value as string,
            lang: locale!,
          });
        }
      }
    }
  } catch (error) {
    console.error("Error updating data:", error);
    return Astro.redirect(`/${locale}/admin/brands?update=error`);
  }
  return Astro.redirect(`/${locale}/admin/brands?update=success`);
}
---

<Layout lang={locale} title="Brand logo list">
  <AdminNavbar lang={locale!} />
  <div class="container p-8">
    <h1 class="title pt-20 pb-10 text-3xl">Brand logo list</h1>

    <BrandsTable client:only="react" items={items} locale={locale!} />
  </div>
  <div class="container p-8 pt-16">
    <form
      method="POST"
      enctype="multipart/form-data"
      class="flex flex-col items-start gap-4"
    >
      <label for="file" class="mb-2 block text-sm font-medium"
        >Upload new logo (filename will be used as alt text)</label
      >
      <input
        type="file"
        name="file"
        multiple
        class="border-input bg-background ring-offset-background placeholder:text-muted-foreground focus-visible:ring-ring mb-4 flex h-10 w-full rounded-md border px-3 py-2 text-sm text-black file:border-0 file:bg-transparent file:text-sm file:font-medium focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:outline-none disabled:cursor-not-allowed disabled:opacity-50"
      />

      <Label htmlFor="projects">Projects</Label>
      <Textarea
        name="projects"
        className="bg-transparent text-white"
        rows={5}
        defaultValue={dict.projects}
      />
      <Label htmlFor="ctaHook">Cta Hook</Label>
      <Input
        name="ctaHook"
        className="bg-transparent text-white"
        defaultValue={dict.ctaHook}
      />
      <Label htmlFor="ctaButton">Cta Button</Label>
      <Input
        name="ctaButton"
        className="bg-transparent text-white"
        defaultValue={dict.ctaButton}
      />
      <Button type="submit" variant="secondary">send</Button>
    </form>
  </div>
  <script>
    import { toast } from "@/hooks/use-toast";

    const urlParams = new URLSearchParams(window.location.search);
    const updateStatus = urlParams.get("update");

    if (updateStatus === "success") {
      toast({
        title: "Success",
        description: "Update successful!",
      });
    } else if (updateStatus === "error") {
      toast({
        title: "Error",
        description: "Update failed.",
        variant: "destructive",
      });
    }
  </script>
</Layout>
