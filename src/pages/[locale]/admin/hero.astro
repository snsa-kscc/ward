---
import Layout from "@/layouts/Layout.astro";
import AdminNavbar from "@/components/admin/AdminNavbar.astro";
import { Label } from "@/components/ui/label";
import { Input } from "@/components/ui/input";
import { Button } from "@/components/ui/button";
import { Textarea } from "@/components/ui/textarea";
import { db } from "db";
import { store } from "db/schema";
import { eq, and } from "drizzle-orm";

const { locale } = Astro.params;

const res = await db
  .select()
  .from(store)
  .where(and(eq(store.section, "hero"), eq(store.lang, locale!)));

const dict = res.reduce(
  (acc, cur) => {
    acc[cur.key as string] = cur.value as string;
    return acc;
  },
  {} as Record<string, string>
);

if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();
  try {
    for (const [key, value] of formData.entries()) {
      const existing = await db
        .select()
        .from(store)
        .where(and(eq(store.key, key as string), eq(store.lang, locale!)))
        .limit(1);

      if (existing.length > 0) {
        await db
          .update(store)
          .set({ value: value as string })
          .where(and(eq(store.key, key as string), eq(store.lang, locale!)));
      } else {
        await db.insert(store).values({
          section: "hero",
          key: key as string,
          value: value as string,
          lang: locale!,
        });
      }
    }
  } catch (error) {
    console.error("Error updating data:", error);
    return Astro.redirect(`/${locale}/admin/hero?update=error`);
  }
  return Astro.redirect(`/${locale}/admin/hero?update=success`);
}
---

<Layout lang={locale} title="Hero">
  <AdminNavbar lang={locale!} />
  <div class="container p-8">
    <h1 class="title py-20 text-3xl">Hero</h1>
    <form method="POST" class="flex flex-col items-start gap-4">
      <Label htmlFor="navbarLinks">Navbar links</Label>
      <Input
        type="text"
        name="navbarLinks"
        required
        className="bg-transparent text-white"
        defaultValue={dict.navbarLinks}
      />
      <Label htmlFor="siteTitleFirst">Site title first</Label>
      <Input
        type="text"
        name="siteTitleFirst"
        required
        className="bg-transparent text-white"
        defaultValue={dict.siteTitleFirst}
      />
      <Label htmlFor="siteTitleSecond">Site title second</Label>
      <Input
        type="text"
        name="siteTitleSecond"
        required
        className="bg-transparent text-white"
        defaultValue={dict.siteTitleSecond}
      />
      <Label htmlFor="siteDescriptionFirst"
        >Site description first (__ for super-powers, only once)</Label
      >
      <Input
        type="text"
        name="siteDescriptionFirst"
        className="bg-transparent text-white"
        defaultValue={dict.siteDescriptionFirst}
      />
      <Label htmlFor="siteDescriptionSecond">Site description second</Label>
      <Input
        type="text"
        name="siteDescriptionSecond"
        className="bg-transparent text-white"
        defaultValue={dict.siteDescriptionSecond}
      />
      <Label htmlFor="aboutKey">About key</Label>
      <Input
        type="text"
        name="aboutKey"
        className="bg-transparent text-white"
        defaultValue={dict.aboutKey}
      />
      <Label htmlFor="about">About (__ for super-powers, multiple times)</Label>
      <Textarea
        name="about"
        className="bg-transparent text-white"
        rows={5}
        defaultValue={dict.about}
      />
      <Label htmlFor="specialitiesKey">Specialities key</Label>
      <Input
        type="text"
        name="specialitiesKey"
        className="bg-transparent text-white"
        defaultValue={dict.specialitiesKey}
      />
      <Label htmlFor="specialities">Specialities</Label>
      <Textarea
        name="specialities"
        className="bg-transparent text-white"
        rows={5}
        defaultValue={dict.specialities}
      />
      <Label htmlFor="specialitiesDescription">Specialities description</Label>
      <Textarea
        name="specialitiesDescription"
        className="bg-transparent text-white"
        rows={5}
        defaultValue={dict.specialitiesDescription}
      />
      <Button type="submit" variant="secondary">send</Button>
    </form>
  </div>
  <script>
    import { toast } from "@/hooks/use-toast";

    const urlParams = new URLSearchParams(window.location.search);
    const updateStatus = urlParams.get("update");

    if (updateStatus === "success") {
      toast({
        title: "Success",
        description: "Update successful!",
      });
    } else if (updateStatus === "error") {
      toast({
        title: "Error",
        description: "Update failed.",
        variant: "destructive",
      });
    }
  </script>
</Layout>
