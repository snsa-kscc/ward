---
import Layout from "@/layouts/Layout.astro";
import AdminNavbar from "@/components/AdminNavbar.astro";
import { db } from "db";
import { accolades } from "db/schema";
import { desc, eq } from "drizzle-orm";
import { Button } from "@/components/ui/button";
import AccoladesTable from "@/components/AccoladesTable";

const { locale } = Astro.params;
const accoladeData = await db
  .select()
  .from(accolades)
  .where(eq(accolades.lang, locale!))
  .orderBy(desc(accolades.createdAt));
const items = accoladeData.map((item) => ({
  id: item.id,
  item: item.item!,
}));
---

<Layout lang={locale} title="Accolades list">
  <AdminNavbar lang={locale!} />
  <div class="container px-8">
    <h1 class="title py-20 text-3xl">Accolades list</h1>
    <Button variant="secondary"
      ><a href={`/${locale}/admin/accolades/new`}>New accolade</a></Button
    >
    <AccoladesTable client:only="react" items={items} locale={locale!} />
  </div>
</Layout>
