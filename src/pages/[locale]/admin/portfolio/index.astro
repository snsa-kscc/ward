---
import Layout from "@/layouts/Layout.astro";
import AdminNavbar from "@/components/AdminNavbar.astro";
import { db } from "db";
import { portfolio } from "db/schema";
import { desc } from "drizzle-orm";
import { Button } from "@/components/ui/button";
import PortfolioTable from "@/components/PortfolioTable";

const { locale } = Astro.params;
const portfolioItems = await db
  .select()
  .from(portfolio)
  .orderBy(desc(portfolio.createdAt));
const items = portfolioItems.map((item) => ({
  id: item.id,
  title: item.title!,
  slug: item.slug!,
}));
---

<Layout lang={locale} title="Portfolio list">
  <AdminNavbar lang={locale!} />
  <div class="container px-8">
    <h1 class="title pt-20 pb-10 text-3xl">Portfolio</h1>
    <Button variant="secondary"
      ><a href={`/${locale}/admin/portfolio/new`}>New item</a></Button
    >
    <PortfolioTable client:only="react" items={items} locale={locale!} />
  </div>
</Layout>
