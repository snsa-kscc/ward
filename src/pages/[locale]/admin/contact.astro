---
import Layout from "@/layouts/Layout.astro";
import AdminNavbar from "@/components/admin/AdminNavbar.astro";
import { db } from "db";
import { store } from "db/schema";
import { and, eq } from "drizzle-orm";
import { Label } from "@/components/ui/label";
import { Input } from "@/components/ui/input";
import { Button } from "@/components/ui/button";
import { upsertStoreData } from "@/lib/store";

const { locale } = Astro.params;

const res = await db
  .select()
  .from(store)
  .where(and(eq(store.section, "footer"), eq(store.lang, locale!)));

const dict = res.reduce(
  (acc, cur) => {
    acc[cur.key as string] = cur.value as string;
    return acc;
  },
  {} as Record<string, string>
);

if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();
  const result = await upsertStoreData({
    formData,
    section: "footer",
    locale: locale!,
    fileKeys: ["ctaPicture"],
  });

  if (result.success) {
    return Astro.redirect(`/${locale}/admin/contact?update=success`);
  } else {
    return Astro.redirect(`/${locale}/admin/contact?update=error`);
  }
}
---

<Layout lang={locale} title="Contact">
  <AdminNavbar lang={locale!} />
  <div class="container p-8">
    <h1 class="title py-20 text-3xl">Contact</h1>
    <form
      method="POST"
      enctype="multipart/form-data"
      class="flex flex-col items-start gap-4"
    >
      <Label htmlFor="ctaHeading">Cta Heading</Label>
      <Input
        type="text"
        name="ctaHeading"
        required
        className="bg-transparent text-white"
        defaultValue={dict.ctaHeading}
      />
      {
        dict.ctaPicture && (
          <div class="flex items-center gap-4 px-6 py-2">
            <p>{dict.ctaPicture}</p>
            <Button className="btn" variant="destructive">
              delete
            </Button>
          </div>
        )
      }
      <Label htmlFor="ctaPicture"
        >Cta Picture - make sure the file is called cta-{locale}.jpg - won't
        render otherwise</Label
      >
      <Input
        type="file"
        name="ctaPicture"
        className="text-black"
        disabled={dict.ctaPicture ? true : false}
      />
      <Label htmlFor="contactKey">Contact Key</Label>
      <Input
        type="text"
        name="contactKey"
        required
        className="bg-transparent text-white"
        defaultValue={dict.contactKey}
      />
      <div class="flex w-full flex-col items-center gap-4 md:flex-row">
        <Label htmlFor="contactEmail">Email</Label>
        <Input
          type="email"
          name="contactEmail"
          required
          className="bg-transparent text-white"
          defaultValue={dict.contactEmail}
        />
        <Label htmlFor="contactPhone">Phone</Label>
        <Input
          type="tel"
          name="contactPhone"
          required
          className="bg-transparent text-white"
          defaultValue={dict.contactPhone}
        />
        <Label htmlFor="contactAddress">Address</Label>
        <Input
          type="text"
          name="contactAddress"
          required
          className="bg-transparent text-white"
          defaultValue={dict.contactAddress}
        />
      </div>
      <Label htmlFor="infoKey">Info Key</Label>
      <Input
        type="text"
        name="infoKey"
        required
        className="bg-transparent text-white"
        defaultValue={dict.infoKey}
      />
      <Label htmlFor="newsletterKey">Newsletter Key</Label>
      <Input
        type="text"
        name="newsletterKey"
        required
        className="bg-transparent text-white"
        defaultValue={dict.newsletterKey}
      />
      <div class="flex w-full flex-col items-center gap-4 md:flex-row">
        <Label htmlFor="newsletterButton">Newsletter Button</Label>
        <Input
          type="text"
          name="newsletterButton"
          required
          className="bg-transparent text-white"
          defaultValue={dict.newsletterButton}
        />
        <Label htmlFor="newsletterDisclaimer">Newsletter Disclaimer</Label>
        <Input
          type="text"
          name="newsletterDisclaimer"
          required
          className="bg-transparent text-white"
          defaultValue={dict.newsletterDisclaimer}
        />
      </div>
      <Label htmlFor="copyright">Copyright</Label>
      <Input
        type="text"
        name="copyright"
        required
        className="bg-transparent text-white"
        defaultValue={dict.copyright}
      />
      <Button type="submit" variant="secondary">send</Button>
    </form>
  </div>
  <script>
    import { toast } from "@/hooks/use-toast";
    import { actions } from "astro:actions";

    const urlParams = new URLSearchParams(window.location.search);
    const updateStatus = urlParams.get("update");

    if (updateStatus === "success") {
      toast({
        title: "Success",
        description: "Update successful!",
      });
    } else if (updateStatus === "error") {
      toast({
        title: "Error",
        description: "Update failed.",
        variant: "destructive",
      });
    }

    const button = document.querySelector(".btn") as HTMLButtonElement;
    const file = document.querySelector("input[type=file]") as HTMLInputElement;
    const locale = document.documentElement.lang;

    if (button) {
      button.addEventListener("click", async (e) => {
        e.preventDefault();
        const result = await actions.deleteMedia({
          title: button.previousElementSibling?.textContent ?? "",
          lang: locale,
        });
        if (result.data === "deleted") {
          button.parentElement?.remove();
          file.disabled = false;
        }
      });
    }
  </script>
</Layout>
