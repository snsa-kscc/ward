---
import { cn } from "@/lib/utils";

type Props = {
  data: {
    specialitiesKey: string;
    specialitiesDescription: string;
    specialities: string;
  };
};

const { data } = Astro.props;
---

<section class="overflow-hidden font-bold ~my-40/72">
  <div class="specs-wrapper container px-4 ~text-base/3xl ~mb-14/24">
    {
      data.specialitiesKey
        .split(/(\s)/)
        .map((word) => (
          <div class="specs-word inline-block">
            {word === " " ? (
              <span class="specs-char inline-block">&nbsp;</span>
            ) : (
              word.split("").map((char) => <span class="specs-char inline-block">{char}</span>)
            )}
          </div>
        ))
    }
  </div>
  {
    data.specialities.split("\r\n").map((item, idx) => {
      return (
        <div class={cn("specs-slider relative w-max whitespace-nowrap", idx === 0 ? "" : "reverse")}>
          {Array.from({ length: 2 }).map((_, i) => (
            <p class={cn("relative w-full will-change-transform ~text-6xl/10xl", i !== 0 ? "absolute left-full top-0" : "")} data-idx={`${idx}-${i}`}>
              {`${item} ${item}`}&nbsp;
            </p>
          ))}
        </div>
      );
    })
  }
  <p class="ml-auto w-full text-balance px-4 pt-40 opacity-0 ~lg:~text-xl/4xl sm:w-1/2" data-specialities-description>
    {data.specialitiesDescription}
  </p>
</section>

<style>
  .specs-wrapper {
    --color-highlight-start: #03c52f;
    background: none;
    color: var(--color-highlight-start);
    position: relative;
    white-space: nowrap;
  }
</style>

<script>
  import gsap from "gsap";
  import ScrollTrigger from "gsap/ScrollTrigger";
  import { isInViewport } from "@/lib/utils";
  gsap.registerPlugin(ScrollTrigger);

  const specsElement = document.querySelector(".specs-wrapper span") as HTMLElement;
  const specsChars = document.querySelectorAll(".specs-char") as NodeListOf<HTMLElement>;
  const animationDefaults = {
    duration: 0.3,
    ease: "power3.in",
  };

  function animateKeyChars() {
    specsChars.forEach((char) => {
      gsap.timeline({ defaults: animationDefaults }).fromTo(
        char,
        {
          filter: "brightness(100%) drop-shadow(0px 0px 30px #0000ff)",
          willChange: "filter",
        },
        {
          delay: gsap.utils.random(0, 1),
          repeat: 10,
          yoyo: true,
          filter: "brightness(300%) drop-shadow(0px 0px 40px #00ff00)",
        }
      );
    });
  }

  function resetKeyChars() {
    gsap.killTweensOf(specsChars);
    gsap.set(specsChars, {
      opacity: 1,
    });
  }

  ScrollTrigger.create({
    trigger: specsElement,
    start: "top bottom",
    onEnter: () => animateKeyChars(),
    onEnterBack: () => animateKeyChars(),
    onLeave: () => resetKeyChars(),
    onLeaveBack: () => resetKeyChars(),
  });

  const sliders = document.querySelectorAll(".specs-slider") as NodeListOf<HTMLDivElement>;
  let direction = -1;

  function animateSlider(slider: HTMLDivElement, directionMultiplier: number) {
    const firstElement = slider.firstElementChild;
    const lastElement = slider.lastElementChild;
    let xPercent = 0;

    function animate() {
      if (xPercent < -100) {
        xPercent = 0;
      } else if (xPercent > 0) {
        xPercent = -100;
      }
      gsap.set(firstElement, { xPercent });
      gsap.set(lastElement, { xPercent });
      xPercent += 0.1 * direction * directionMultiplier;
      requestAnimationFrame(animate);
    }

    requestAnimationFrame(animate);
  }

  sliders.forEach((slider) => {
    const isReverse = slider.classList.contains("reverse");
    animateSlider(slider, isReverse ? -1 : 1);
  });

  ScrollTrigger.create({
    trigger: sliders[0].parentElement,
    start: 0,
    end: 0,
    onUpdate: (self) => (direction = self.direction * -1),
  });

  window.addEventListener(
    "scroll",
    () => {
      const specsDesc = document.querySelector("[data-specialities-description]");
      if (specsDesc && isInViewport(specsDesc)) {
        specsDesc.classList.add("animate-in", "fade-in", "opacity-100", "slide-in-from-right", "duration-1000");
      }
    },
    { passive: true }
  );
</script>
