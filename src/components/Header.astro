---
type PageData = {
  id: number;
  name: string | null;
  slug: string | null;
  title: string | null;
  content: string | null;
  lang: string | null;
};

type Props = {
  lang: string;
  id?: string;
  slug?: string;
  links?: string;
  pagesData?: PageData[];
};

const { lang, id, slug, links, pagesData } = Astro.props;
const anotherLocale = lang === "hr" ? "en" : "hr";
let anotherSlug;

if (slug && pagesData) {
  const currentPage = pagesData.find(
    (page) => page.slug === slug && page.lang === lang
  );
  if (currentPage) {
    const translatedPage = pagesData.find(
      (page) => page.name === currentPage.name && page.lang === anotherLocale
    );
    anotherSlug = translatedPage?.slug;
  }
}

let href: string;

switch (true) {
  case !!id:
    href = `/${anotherLocale !== "en" ? `${anotherLocale}/` : ""}portfolio/${id}`;
    break;
  case !!slug:
    href = `/${anotherLocale !== "en" ? `${anotherLocale}/` : ""}${anotherSlug}`;
    break;
  default:
    href = `/${anotherLocale !== "en" ? `${anotherLocale}` : ""}`;
}

const linksArray = links?.split(",").map((link) => link.trim());

function capitalizeLink(str: string) {
  return str.charAt(0).toUpperCase() + str.slice(1);
}
---

<header
  class="fixed top-0 z-50 w-full translate-y-0 border-b border-stone-200 bg-stone-50 text-stone-950 transition-transform duration-300"
>
  <div
    class="container flex items-center justify-between px-[clamp(6,10)] py-[clamp(6,8)] text-[clamp(var(--text-base),var(--text-lg))]"
  >
    <div class="flex items-center">
      <a href={lang === "hr" ? "/hr" : "/"} class="text-3xl font-medium">WARD</a
      >
    </div>

    <!-- Desktop Navigation -->
    <div class="hidden items-center space-x-[clamp(16,24)] md:flex">
      <div class="flex items-center space-x-4">
        {
          linksArray?.map((link) => (
            <a
              href={lang === "hr" ? `/${lang}/#${link}` : `/#${link}`}
              class="relative text-2xl font-medium transition-colors after:absolute after:bottom-0 after:left-0 after:h-1 after:w-0 after:bg-stone-700 after:transition-all after:duration-300 after:ease-in-out hover:text-stone-700 hover:after:w-full"
            >
              {capitalizeLink(link.replaceAll("-", " "))}
            </a>
          ))
        }
      </div>

      <!-- Hidden language selector (keep functionality) -->
      <a
        href={href}
        class="sr-only font-medium"
        aria-label="Switch to {anotherLocale.toUpperCase()} language"
      >
        {anotherLocale.toUpperCase()}
      </a>
    </div>

    <!-- Mobile Hamburger Menu -->
    <div class="md:hidden">
      <button
        id="mobile-menu-button"
        class="relative flex h-[clamp(24,32)] w-[clamp(24,32)] flex-col items-center justify-center focus:outline-none"
        aria-label="Toggle menu"
      >
        <span class="sr-only">Menu</span>
        <span
          class="absolute h-0.5 w-6 transform bg-stone-950 transition-all duration-300 ease-in-out"
          id="hamburger-line-1"></span>
        <span
          class="absolute h-0.5 w-6 transform bg-stone-950 transition-all duration-300 ease-in-out"
          id="hamburger-line-2"></span>
        <span
          class="absolute h-0.5 w-6 transform bg-stone-950 transition-all duration-300 ease-in-out"
          id="hamburger-line-3"></span>
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div
    id="mobile-menu"
    class="absolute top-full left-0 w-full -translate-x-full transform border-t border-stone-200 bg-stone-50 transition-transform duration-300 ease-in-out md:hidden"
  >
    <div class="container px-[clamp(6,10)] py-[clamp(6,10)]">
      <div class="flex flex-col space-y-[clamp(12,16)]">
        {
          linksArray?.map((link) => (
            <a
              href={lang === "hr" ? `/${lang}/#${link}` : `/#${link}`}
              class="py-2 font-medium transition-colors hover:text-stone-700"
            >
              {capitalizeLink(link.replaceAll("-", " "))}
            </a>
          ))
        }
      </div>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector("header") as HTMLElement;
  const mobileMenuButton = document.getElementById(
    "mobile-menu-button"
  ) as HTMLButtonElement;
  const mobileMenu = document.getElementById("mobile-menu") as HTMLElement;
  const hamburgerLine1 = document.getElementById(
    "hamburger-line-1"
  ) as HTMLElement;
  const hamburgerLine2 = document.getElementById(
    "hamburger-line-2"
  ) as HTMLElement;
  const hamburgerLine3 = document.getElementById(
    "hamburger-line-3"
  ) as HTMLElement;

  let lastScrollY = window.scrollY;
  let isMenuOpen = false;

  // Scroll direction detection - hide on scroll up
  window.addEventListener("scroll", () => {
    const currentScrollY = window.scrollY;

    // Don't hide header if at the top of the page or within 50px offset
    if (currentScrollY <= 0) {
      header.classList.remove("-translate-y-full");
      header.classList.add("translate-y-0");
      return;
    }

    if (currentScrollY > lastScrollY && currentScrollY > 100) {
      // Scrolling down - show header
      header.classList.remove("-translate-y-full");
      header.classList.add("translate-y-0");
    } else if (currentScrollY < lastScrollY && currentScrollY > 10) {
      // Scrolling up - hide header, but only if past 10px offset
      header.classList.add("-translate-y-full");
      header.classList.remove("translate-y-0");
    }

    lastScrollY = currentScrollY;
  });

  // Set initial positions for hamburger lines
  hamburgerLine1.style.transform = "translateY(-6px)";
  hamburgerLine2.style.transform = "translateY(0)";
  hamburgerLine3.style.transform = "translateY(6px)";

  // Mobile menu toggle
  mobileMenuButton?.addEventListener("click", () => {
    isMenuOpen = !isMenuOpen;

    if (isMenuOpen) {
      // Open menu
      mobileMenu.classList.remove("-translate-x-full");
      mobileMenu.classList.add("translate-x-0");

      // Animate hamburger to X
      hamburgerLine1.style.transform = "rotate(45deg) translateY(0)";
      hamburgerLine2.style.transform = "scale(0)";
      hamburgerLine3.style.transform = "rotate(-45deg) translateY(0)";
    } else {
      // Close menu
      mobileMenu.classList.add("-translate-x-full");
      mobileMenu.classList.remove("translate-x-0");

      // Reset hamburger
      hamburgerLine1.style.transform = "translateY(-6px)";
      hamburgerLine2.style.transform = "translateY(0)";
      hamburgerLine3.style.transform = "translateY(6px)";
    }
  });

  // Close menu when clicking links
  const mobileLinks = mobileMenu?.querySelectorAll("a");
  mobileLinks?.forEach((link) => {
    link.addEventListener("click", () => {
      if (isMenuOpen) {
        mobileMenuButton.click();
      }
    });
  });

  // Close menu on ESC key
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && isMenuOpen) {
      mobileMenuButton.click();
    }
  });

  // Close menu when clicking outside
  document.addEventListener("click", (e) => {
    if (
      isMenuOpen &&
      !mobileMenuButton?.contains(e.target as Node) &&
      !mobileMenu?.contains(e.target as Node)
    ) {
      mobileMenuButton.click();
    }
  });
</script>
