---
import { Image } from "astro:assets";

type Props = {
  data: {
    name: string | null;
    slug: string | null;
    logo: string | null;
  }[];
};

const { data } = Astro.props;
---

<section class="flex gap-20 overflow-hidden bg-gradient-to-r from-wardGreen to-wardBlue ~my-40/72 ~py-8/16 lg:gap-36">
  {
    Array.from({ length: 4 }).map(() => (
      <div class="marquee-scroll flex flex-shrink-0 justify-around gap-20 will-change-transform lg:gap-36">
        {data.map((brand) => (
          <div class="flex items-center">
            <Image class="~w-14/24" src={`/assets/brands/${brand.logo}`} alt={brand.name} width={96} height={54} />
          </div>
        ))}
      </div>
    ))
  }
</section>

<style>
  @keyframes scroll {
    from {
      transform: translateX(0);
    }

    to {
      transform: translateX(calc(-100% - 5rem));
    }
  }

  @media (min-width: 1024px) {
    @keyframes scroll {
      from {
        transform: translateX(0);
      }

      to {
        transform: translateX(calc(-100% - 9rem));
      }
    }
  }

  .marquee-scroll {
    animation: scroll 20s linear infinite;
  }
</style>
