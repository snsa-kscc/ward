---
import { formatParagraph } from "@/lib/utils";

type Props = {
  data: {
    aboutKey: string;
    about: string;
    navbarLinks: string;
  };
};

const { data } = Astro.props;

const splitTag = "__";
const parts: (text: string) => string[] = (text) => formatParagraph(text).split(splitTag).filter(Boolean);
---

<section
  id={data.navbarLinks
    .split(",")
    .map((link) => link.trim())
    .at(1)}
  class="container flex items-start gap-20 px-4 ~my-40/72"
>
  <div class="about-key-wrapper basis-1/3 font-bold will-change-transform ~text-base/8xl ~mb-14/24">
    {
      data.aboutKey
        .split(/(\s)/)
        .map((word) => (
          <div class="about-key-word inline-block">
            {word === " " ? (
              <span class="about-key-char inline-block">&nbsp;</span>
            ) : (
              word.split("").map((char) => <span class="about-key-char inline-block">{char}</span>)
            )}
          </div>
        ))
    }
  </div>
  <div class="highlighted inline-block text-balance !leading-[7vh] ~text-lg/4xl">
    {
      parts(data.about).map((part, index) => {
        if (index % 2 === 1) {
          const splitChars = part.split("").map((char) => {
            if (char === " ") {
              return (
                <span class="about-char inline-block" data-char={char}>
                  &nbsp;
                </span>
              );
            }
            return (
              <span class="about-char inline-block" data-char={char}>
                {char}
              </span>
            );
          });
          return <mark data-char={part}>{splitChars}</mark>;
        }
        return <span set:html={part} />;
      })
    }
  </div>
</section>

<style>
  .about-key-wrapper {
    --color-highlight-start: #085ed0;
    background: none;
    color: var(--color-highlight-start);
    display: inline-block;
    position: relative;
    white-space: nowrap;
  }

  .highlighted mark {
    --color-highlight-start: #fff;
    --color-highlight-end: #03c52f;
    --color-highlight-end-alt: #085ed0;
    background: none;
    color: var(--color-highlight-start);
    display: inline-block;
    position: relative;
    white-space: nowrap;
  }
</style>

<script>
  import gsap from "gsap";
  import ScrollTrigger from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  const aboutKeyWrapper = document.querySelector(".about-key-wrapper") as HTMLElement;

  gsap.to(aboutKeyWrapper, {
    rotate: 360,
    scrollTrigger: {
      trigger: aboutKeyWrapper,
      start: "top 70%",
      end: "top 40%",
      scrub: 1,
    },
  });

  const highlightedKeyElement = document.querySelector(".about-key-wrapper span") as HTMLElement;
  const keyChars = document.querySelectorAll(".about-key-char") as NodeListOf<HTMLElement>;
  const animationDefaults = {
    duration: 0.3,
    ease: "power3.in",
  };

  function animateKeyChars() {
    keyChars.forEach((char) => {
      gsap.timeline({ defaults: animationDefaults }).fromTo(
        char,
        {
          filter: "brightness(100%) drop-shadow(0px 0px 30px #00ff00)",
          willChange: "filter",
        },
        {
          delay: gsap.utils.random(0, 1),
          repeat: 10,
          yoyo: true,
          filter: "brightness(300%) drop-shadow(0px 0px 40px #0000ff)",
        }
      );
    });
  }

  function resetKeyChars() {
    gsap.killTweensOf(keyChars);
    gsap.set(keyChars, {
      opacity: 1,
    });
  }

  ScrollTrigger.create({
    trigger: highlightedKeyElement,
    start: "top bottom",
    onEnter: () => animateKeyChars(),
    onEnterBack: () => animateKeyChars(),
    onLeave: () => resetKeyChars(),
    onLeaveBack: () => resetKeyChars(),
  });

  const highlightedElement = document.querySelector(".highlighted mark") as HTMLElement;
  const chars = document.querySelectorAll(".about-char") as NodeListOf<HTMLElement>;

  function animateChars() {
    gsap
      .timeline({ defaults: animationDefaults })
      .set(chars, { willChange: "transform, color" })
      .to(chars, {
        stagger: 0.05,
        scale: 1.45,
        color: getComputedStyle(highlightedElement).getPropertyValue("--color-highlight-end"),
      })
      .to(
        chars,
        {
          duration: 0.4,
          ease: "sine",
          stagger: 0.05,
          scale: 1,
          color: getComputedStyle(highlightedElement).getPropertyValue("--color-highlight-end-alt"),
        },
        animationDefaults.duration
      );
  }

  ScrollTrigger.create({
    trigger: highlightedElement,
    start: "top bottom",
    onEnter: () => animateChars(),
    once: true,
  });
</script>
