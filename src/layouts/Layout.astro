---
import { cn } from "@/lib/utils";
import "@/styles/globals.css";
import { TailwindIndicator } from "@/components/admin/TailwindIndicator";
import { Toaster } from "@/components/ui/toaster";

interface Props {
  lang?: string;
  title: string;
  description?: string;
}

const { lang, title, description } = Astro.props;
const isAdmin = Astro.url.pathname.includes("admin");
const sanitizedtitle = title.replaceAll("__", "");
const cleanedDescription = description?.replaceAll("__", "") || "";
const sanitizedDescription =
  cleanedDescription.length > 100
    ? cleanedDescription.slice(0, 100) + "..."
    : cleanedDescription;
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={sanitizedDescription} />
    <title>{sanitizedtitle}</title>
  </head>
  <body
    class={cn("bg-stone-50 text-stone-950", {
      "font-[system-ui] tracking-normal bg-black text-white": isAdmin,
    })}
  >
    <slot />
    <TailwindIndicator />
    <Toaster client:load />
  </body>
</html>
