---
import Layout from "@/layouts/Layout.astro";
import Hero from "@/components/Hero.astro";
import About from "@/components/About.astro";
import Portfolio from "@/components/Portfolio.astro";
import Capabilities from "@/components/Capabilities.astro";
import Logos from "@/components/Logos.astro";
import Clients from "@/components/Clients.astro";
import Awards from "@/components/Awards.astro";
import Picture from "@/components/Picture.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { db } from "db";
import { asc, eq } from "drizzle-orm";
import { store, portfolio, brands, clients, awards, pages } from "db/schema";
import type { StoreData } from "@/types/global";
import { defaultLocale } from "@/lib/utils";

const { locale } = Astro.params;

const [
  storeData,
  portfolioData,
  brandsData,
  clientsData,
  awardsData,
  pagesData,
] = await Promise.all([
  db.select().from(store).where(eq(store.lang, locale!)),
  db.select().from(portfolio).orderBy(asc(portfolio.order)),
  db.select().from(brands).orderBy(asc(brands.order)),
  db
    .select()
    .from(clients)
    .where(eq(clients.lang, defaultLocale)) //we are gonna use default locale for clients
    .orderBy(asc(clients.order)),
  db
    .select()
    .from(awards)
    .where(eq(awards.lang, defaultLocale)) //we are gonna use default locale for awards
    .orderBy(asc(awards.order)),
  db
    .select()
    .from(pages)
    .where(eq(pages.lang, locale!))
    .orderBy(asc(pages.name)),
]);

const storeDataMap: StoreData = storeData.reduce((acc, cur) => {
  acc[cur.key as string] = cur.value as string;

  return acc;
}, {} as StoreData);
---

<style>
  .loading-overlay {
    position: fixed;
    pointer-events: none;
    inset: 0;
    z-index: 100;
  }
  .loading-overlay.js-loaded {
    visibility: hidden;
    opacity: 0;
  }
</style>

<Layout
  lang={locale}
  title={storeDataMap.title}
  description={storeDataMap.about}
>
  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const loadingOverlay = document.querySelector(".loading-overlay");
      loadingOverlay?.classList.add("js-loaded");
    });
  </script>
  <div class="loading-overlay bg-zinc-900"></div>
  <Header
    lang={locale!}
    links={storeDataMap.navbarLinks}
    pagesData={pagesData}
  />
  <Hero data={storeDataMap} />
  <About data={storeDataMap} />
  <Portfolio
    locale={locale!}
    data={portfolioData}
    storeDataMap={storeDataMap}
  />
  <Capabilities data={storeDataMap} />
  <Logos data={brandsData} />
  <Clients clientsData={clientsData} storeDataMap={storeDataMap} />
  <Awards awardsData={awardsData} storeDataMap={storeDataMap} />
  <Picture storeDataMap={storeDataMap} />
  <Footer locale={locale!} storeData={storeDataMap} pagesData={pagesData} />
</Layout>
