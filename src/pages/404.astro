---
import Layout from "@/layouts/Layout.astro";

const isHr = Astro.url.pathname.startsWith("/hr/");
---

<Layout lang={isHr ? "hr" : "en"} title="404" description="404">
  <div class="container">
    <div class="py-20 text-9xl font-bold">404</div>
    <div class="404-message py-20 text-xl font-bold">
      {isHr ? "Stranica nije pronađena" : "Page not found"}
    </div>
  </div>
  <script>
    const urlParams = new URLSearchParams(window.location.search);
    const html = document.documentElement;
    const message = document.querySelector(".404-message");
    if (urlParams.get("locale") == "hr") {
      html.lang = "hr";
      message!.innerHTML = "Stranica nije pronađena";
    }
  </script>
</Layout>
