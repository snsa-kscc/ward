---
import type { StoreData } from "@/types/global";

type Props = {
  awardsData: {
    id: number;
    createdAt: Date;
    item: string | null;
  }[];
  storeDataMap: StoreData;
};

const { awardsData, storeDataMap } = Astro.props;

const awardsKeyLines = storeDataMap.awardsKey
  .split(/\r?\n/)
  .filter((line) => line.trim());
---

<section
  class="relative container flex items-start gap-20 border-t border-b border-stone-200 px-4 py-[clamp(40,62)]"
>
  <div class="awards-key-wrapper basis-1/3">
    {
      awardsKeyLines.map((line, index) => (
        <p
          class={
            index === 0
              ? "text-2xl leading-tight font-medium"
              : "text-2xl leading-tight font-medium opacity-30"
          }
        >
          {line}
        </p>
      ))
    }
  </div>

  <div
    class="awards-content basis-2/3 text-[clamp(var(--text-lg),var(--text-xl))] leading-relaxed font-medium"
  >
    <div>
      {
        awardsData.map((item) => {
          return (
            <p class="awards-item mb-2 opacity-20 last:mb-0">{item.item}</p>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .awards-key-wrapper {
    color: rgb(var(--color-stone-950));
  }

  .awards-content {
    color: rgb(var(--color-stone-950));
  }
</style>

<script>
  import gsap from "gsap";
  import ScrollTrigger from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  const awardsSection = document.querySelector(
    ".awards-content"
  ) as HTMLElement;
  const awardsItems = document.querySelectorAll(
    ".awards-item"
  ) as NodeListOf<HTMLElement>;

  if (awardsSection && awardsItems.length) {
    gsap.to(awardsItems, {
      opacity: 1,
      stagger: 0.06,
      scrollTrigger: {
        trigger: awardsSection,
        start: "top 80%",
        end: "bottom 40%",
        scrub: 1,
      },
    });
  }
</script>
