---
import { NewsletterSubscribe } from "./NewsletterSubscribe";

type Props = {
  locale: string;
  storeData: {
    ctaHeading: string;
    contactKey: string;
    contactEmail: string;
    contactPhone: string;
    contactAddress: string;
    infoKey: string;
    newsletterKey: string;
    newsletterButton: string;
    newsletterDisclaimer: string;
    copyright: string;
    navbarLinks: string;
  };
  pagesData: {
    title: string | null;
    slug: string | null;
  }[];
};

const { locale, storeData, pagesData } = Astro.props;
---

<>
  <div class="relative h-screen">
    {
      Array.from({ length: 9 }).map((_, idx) => (
        <div
          style={`background-image: url('/assets/cta-${locale}.jpg')`}
          class={`mask absolute left-0 top-0 h-full w-full bg-contain bg-center bg-no-repeat mask-${idx + 1}`}
        />
      ))
    }
  </div>
  <div
    id={storeData.navbarLinks
      .split(",")
      .map((link) => link.trim())
      .at(-1)}
    class="container px-4 py-40 font-bold ~text-6xl/9xl"
  >
    {
      storeData.ctaHeading.split("").map((char) => {
        if (char === " ") {
          return <span class="cta-char inline-block">&nbsp;</span>;
        }
        return <span class="cta-char inline-block">{char}</span>;
      })
    }
  </div>
  <div class="container my-20 px-4">
    <div class="flex flex-col justify-between gap-16 sm:flex-row">
      <div class="flex basis-1/3 gap-16">
        <div class="basis-1/2">
          <p class="pb-8 font-bold ~text-xl/2xl">{storeData.contactKey}</p>
          <p><a class="underline" href={`mailto:${storeData.contactEmail}`}>{storeData.contactEmail}</a></p>
          <p>tel: <a href={`tel:${storeData.contactPhone.replaceAll(" ", "")}`}>{storeData.contactPhone}</a></p>
          <p>{storeData.contactAddress}</p>
        </div>
        <div class="basis-1/2">
          <div class="pb-8 font-bold ~text-xl/2xl"><p>{storeData.infoKey}</p></div>
          {
            pagesData.map((page) => (
              <div class="">
                <a href={`/${locale !== "en" ? `${locale}/` : ""}${page.slug}`}>{page.title}</a>
              </div>
            ))
          }
        </div>
      </div>
      <div class="basis-1/3">
        <p class="pb-8 font-bold ~text-xl/2xl">{storeData.newsletterKey}</p>
        <NewsletterSubscribe client:load button={storeData.newsletterButton} lang={locale} />
        <p class="pt-6 text-xs" set:html={storeData.newsletterDisclaimer} />
      </div>
    </div>
    <div class="font-bold ~text-xl/2xl ~pt-10/40"><p>{`© ${new Date().getFullYear()} ${storeData.copyright}`}</p></div>
  </div>
</>

<script>
  const initialClipPath = [
    "polygon(0% 0%, 0% 0%, 0% 0%, 0% 0%)",
    "polygon(33% 0%, 33% 0%, 33% 0%, 33% 0%)",
    "polygon(66% 0%, 66% 0%, 66% 0%, 66% 0%)",
    "polygon(0% 33%, 0% 33%, 0% 33%, 0% 33%)",
    "polygon(33% 33%, 33% 33%, 33% 33%, 33% 33%)",
    "polygon(66% 33%, 66% 33%, 66% 33%, 66% 33%)",
    "polygon(0% 66%, 0% 66%, 0% 66%, 0% 66%)",
    "polygon(33% 66%, 33% 66%, 33% 66%, 33% 66%)",
    "polygon(66% 66%, 66% 66%, 66% 66%, 66% 66%)",
  ];

  const finalClipPath = [
    "polygon(0% 0%, 33.5% 0%, 33.5% 33%, 0% 33.5%)",
    "polygon(33% 0%, 66.5% 0%, 66.5% 33%, 33% 33.5%)",
    "polygon(66% 0%, 100% 0%, 100% 33%, 66% 33.5%)",
    "polygon(0% 33%, 33.5% 33%, 33.5% 66%, 0% 66.5%)",
    "polygon(33% 33%, 66.5% 33%, 66.5% 66%, 33% 66.5%)",
    "polygon(66% 33%, 100% 33%, 100% 66%, 66% 66.5%)",
    "polygon(0% 66%, 33.5% 66%, 33.5% 100%, 0% 100%)",
    "polygon(33% 66%, 66.5% 66%, 66.5% 100%, 33% 100%)",
    "polygon(66% 66%, 100% 66%, 100% 100%, 66% 100%)",
  ];

  const masks = document.querySelectorAll(".mask") as NodeListOf<HTMLDivElement>;
  masks.forEach((mask, idx) => {
    gsap.set(mask, { clipPath: initialClipPath[idx] });
  });
  const tl = gsap.timeline({
    scrollTrigger: {
      trigger: masks[0].parentElement,
      start: "top 50%",
    },
  });
  const animationOrder = [[".mask-1"], [".mask-2", ".mask-4"], [".mask-3", ".mask-5", ".mask-7"], [".mask-6", ".mask-8"], [".mask-9"]] as string[][];
  animationOrder.forEach((animationItems, index) => {
    tl.to(
      animationItems,
      {
        clipPath: (_, el) => finalClipPath[Array.from(masks).indexOf(el as HTMLDivElement)],
        duration: 0.5,
        stagger: 0.1,
        ease: "power2.out",
      },
      index * 0.125
    );
  });

  const charsAnimation = document.querySelectorAll(".cta-char") as NodeListOf<HTMLElement>;
  gsap.fromTo(
    charsAnimation,
    {
      opacity: 0,
      skewX: -20,
      willChange: "filter, transform",
      filter: "blur(8px)",
    },
    {
      ease: "sine",
      opacity: 1,
      skewX: 0,
      filter: "blur(0px)",
      stagger: 0.04,
      scrollTrigger: {
        trigger: ".cta-char",
        start: "top 80%",
        end: "top 40%",
        scrub: true,
      },
    }
  );
</script>
