---
import { NewsletterSubscribe } from "./NewsletterSubscribe";

type Props = {
  locale: string;
  storeData: {
    ctaHeading: string;
    contactKey: string;
    contactEmail: string;
    contactPhone: string;
    contactAddress: string;
    infoKey: string;
    newsletterKey: string;
    newsletterButton: string;
    newsletterDisclaimer: string;
    copyright: string;
    navbarLinks: string;
  };
  pagesData: {
    title: string | null;
    slug: string | null;
  }[];
};

const { locale, storeData, pagesData } = Astro.props;
---

<footer class="~mt-40/72">
  <div
    id={storeData.navbarLinks
      .split(",")
      .map((link) => link.trim())
      .at(-1)}
    class="footer-wrapper container px-4 py-20 font-bold ~text-6xl/9xl"
  >
    {
      storeData.ctaHeading.split("").map((char) => {
        if (char === " ") {
          return <span class="cta-char inline-block">&nbsp;</span>;
        }
        return <span class="cta-char inline-block">{char}</span>;
      })
    }
  </div>
  <div class="container my-20 px-4">
    <div class="flex flex-col justify-between gap-16 sm:flex-row">
      <div class="flex basis-1/3 gap-16">
        <div class="basis-1/2">
          <p class="pb-8 font-bold ~text-xl/2xl">{storeData.contactKey}</p>
          <p><a class="underline" href={`mailto:${storeData.contactEmail}`}>{storeData.contactEmail}</a></p>
          <p>tel: <a href={`tel:${storeData.contactPhone.replaceAll(" ", "")}`}>{storeData.contactPhone}</a></p>
          <p>{storeData.contactAddress}</p>
        </div>
        <div class="basis-1/2">
          <div class="pb-8 font-bold ~text-xl/2xl"><p>{storeData.infoKey}</p></div>
          {
            pagesData.map((page) => (
              <div class="">
                <a href={`/${locale !== "en" ? `${locale}/` : ""}${page.slug}`}>{page.title}</a>
              </div>
            ))
          }
        </div>
      </div>
      <div class="basis-1/3">
        <p class="pb-8 font-bold ~text-xl/2xl">{storeData.newsletterKey}</p>
        <NewsletterSubscribe client:load button={storeData.newsletterButton} lang={locale} />
        <p class="pt-6 text-xs font-bold" set:html={storeData.newsletterDisclaimer} />
      </div>
    </div>
    <div class="font-bold ~text-xl/2xl ~pt-10/40"><p>{`© ${new Date().getFullYear()} ${storeData.copyright}`}</p></div>
  </div>
</footer>

<script>
  import { gsap } from "gsap";
  import ScrollTrigger from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  const charsAnimation = document.querySelectorAll(".cta-char") as NodeListOf<HTMLElement>;
  gsap.fromTo(
    charsAnimation,
    {
      opacity: 0,
      skewX: -20,
      willChange: "filter, transform",
      filter: "blur(8px)",
    },
    {
      ease: "sine",
      opacity: 1,
      skewX: 0,
      filter: "blur(0px)",
      stagger: 0.04,
      scrollTrigger: {
        trigger: ".footer-wrapper",
        start: "top 80%",
        end: "top 40%",
        scrub: 1,
      },
    }
  );
</script>
