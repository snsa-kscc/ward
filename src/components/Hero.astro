---
type Props = {
  data: {
    siteTitleFirst: string;
    siteTitleSecond: string;
    siteDescriptionFirst: string;
    siteDescriptionSecond: string;
  };
};

const { data } = Astro.props;

const splitTag = "__";
const parts: (text: string) => string[] = (text) => text.split(splitTag).filter(Boolean);
---

<section class="container ~mt-32/36 ~md:~mb-28/56">
  <!-- <div class="text-center text-7xl font-bold leading-none tracking-tightest sm:text-8xl lg:text-9xl xl:text-10xl">
    {
      data.siteTitleFirst.split("").map((char) => {
        if (char === char.toUpperCase() && char.match(/[A-Z]/)) {
          return (
            <span id="letter" data-text={char}>
              {char}
            </span>
          );
        } else {
          return char;
        }
      })
    }
  </div> -->
  <div class="flex flex-col items-center justify-center">
    <div class="hero-words inline-block overflow-hidden font-bold leading-none tracking-tighter ~text-5xl/10xl">
      {
        data.siteTitleFirst.split("").map((char) => {
          if (char === char.toUpperCase() && char.match(/[A-Z]/)) {
            return <span class="hero-char stroke inline-block origin-[center_top_0px] will-change-transform">{char}</span>;
          }
          return <span class="hero-char inline-block origin-[center_top_0px] will-change-transform">{char}</span>;
        })
      }
    </div>
    <div class="hero-words inline-block overflow-hidden font-bold leading-none tracking-tighter ~text-5xl/10xl">
      {
        data.siteTitleSecond.split("").map((char) => {
          if (char === char.toUpperCase() && char.match(/[A-Z]/)) {
            return <span class="hero-char stroke inline-block origin-[center_top_0px] will-change-transform">{char}</span>;
          }
          return <span class="hero-char inline-block origin-[center_top_0px] will-change-transform">{char}</span>;
        })
      }
    </div>
  </div>
  <!-- <div class="text-center text-7xl font-bold leading-none tracking-tightest sm:text-8xl lg:text-9xl xl:text-10xl">
    {
      data.siteTitleSecond.split("").map((char) => {
        if (char === char.toUpperCase() && char.match(/[A-Z]/)) {
          return (
            <span id="letter" data-text={char}>
              {char}
            </span>
          );
        } else {
          return char;
        }
      })
    }
  </div> -->
  <div class="expertise expertise-wrapper mt-24 flex overflow-hidden text-balance px-4 font-bold will-change-transform ~text-2xl/5xl">
    {
      parts(data.siteDescriptionFirst).map((item, index) => {
        if (index % 2 === 0) {
          return <div class="inline-block ~pr-2/3">{item}</div>;
        }
        return (
          <div class="expertise-animation relative inline-block">
            {item.split(";").map((word) => {
              return (
                <div class="absolute left-0 top-0 w-max" data-text={word}>
                  <div class="overflow-hidden">
                    {word.split("").map((char) => {
                      return <span class="hero-char inline-block">{char}</span>;
                    })}
                  </div>
                </div>
              );
            })}
          </div>
        );
      })
    }
  </div>
  <h1 class="expertise expertise-hook mt-24 text-balance px-4 text-end font-bold will-change-transform ~text-2xl/5xl">
    {data.siteDescriptionSecond}
  </h1>
</section>

<style>
  #letter {
    --color: #fff;
    position: relative;
    color: transparent;
  }

  #letter::after {
    content: attr(data-text);
    position: absolute;
    inset: 0;
    z-index: 5;
    -webkit-text-stroke: 1px var(--color);
    line-height: 0.9;
  }

  .stroke {
    -webkit-text-stroke: 1px #fff;
    color: transparent;
  }

  .hero-words {
    transform-style: preserve-3d;
    perspective: 1000px;
  }

  .expertise {
    transform-style: preserve-3d;
    transform: perspective(800px);
    transform-origin: bottom center;
  }

  .hero-char {
    will-change: transform, opacity;
  }
</style>

<script>
  // const letters = document.querySelectorAll("#letter") as NodeListOf<HTMLElement>;
  // setTimeout(() => {
  //   gsap.to(
  //     {},
  //     {
  //       duration: 10,
  //       onUpdate: function () {
  //         const progress = this.progress();
  //         letters.forEach((letter) => {
  //           letter.style.color = `hsla(0, 0%, 100%, ${progress})`;
  //         });
  //       },
  //     }
  //   );
  // }, 1000);

  const firstLineChars = document.querySelectorAll(".hero-words:first-of-type .hero-char") as NodeListOf<HTMLElement>;
  const secondLineChars = document.querySelectorAll(".hero-words:last-of-type .hero-char") as NodeListOf<HTMLElement>;
  const expertiseWrapper = document.querySelector(".expertise-wrapper") as HTMLElement;
  const expertiseHook = document.querySelector(".expertise-hook") as HTMLElement;
  const expertises = document.querySelectorAll(".expertise-animation > div") as NodeListOf<HTMLElement>;

  const tl = gsap.timeline({ delay: 0.8 });
  tl.from(firstLineChars, {
    duration: 0.7,
    yPercent: 85,
    opacity: 0,
    rotateX: -90,
    stagger: 0.04,
    ease: "power2.out",
  });
  tl.from(secondLineChars, {
    duration: 0.6,
    yPercent: 100,
    stagger: 0.06,
    ease: "power2.out",
  });
  tl.from(expertiseWrapper, {
    duration: 0.4,
    opacity: 0,
    rotateX: "55",
  });
  tl.from(expertiseHook, {
    duration: 0.4,
    opacity: 0,
    rotateX: "55",
  });

  const expertiseTl = gsap.timeline({
    repeat: -1,
  });
  expertises.forEach((item) => {
    const chars = item.querySelectorAll(".hero-char") as NodeListOf<HTMLElement>;
    expertiseTl
      .fromTo(
        chars,
        {
          yPercent: 100,
          opacity: 0,
        },
        {
          duration: 0.5,
          yPercent: 0,
          opacity: 1,
          stagger: 0.05,
          ease: "power2.out",
        }
      )
      .to(
        chars,
        {
          duration: 0.5,
          yPercent: -100,
          opacity: 0,
          stagger: 0.05,
          ease: "power2.in",
        },
        "+=1"
      );
  });
  tl.add(expertiseTl);
</script>
