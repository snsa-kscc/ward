---
import type { StoreData } from "@/types/global";

type Props = {
  data: StoreData;
};

const { data } = Astro.props;

// Split aboutKey on line breaks - first line normal, rest with opacity
const aboutKeyLines = data.aboutKey
  .split(/\r?\n/)
  .filter((line) => line.trim());

// Split about text into words
const aboutWords = data.about.split(/\s+/).filter((word) => word.trim());
---

<section
  id={data.navbarLinks
    .split(",")
    .map((link) => link.trim())
    .at(0)}
  class="relative container flex items-start gap-20 border-t border-b border-stone-200 px-4 py-[clamp(40,62)]"
>
  <div class="about-key-wrapper basis-1/3">
    {
      aboutKeyLines.map((line, index) => (
        <p
          class={
            index === 0
              ? "text-2xl leading-tight font-medium"
              : "text-2xl leading-tight font-medium opacity-30"
          }
        >
          {line}
        </p>
      ))
    }
  </div>

  <div
    class="about-content basis-2/3 text-[clamp(var(--text-lg),var(--text-2xl))] leading-relaxed font-medium"
  >
    {
      aboutWords.map((word) => (
        <span class="about-word inline opacity-20">{word} </span>
      ))
    }
  </div>
</section>

<style>
  .about-key-wrapper {
    color: rgb(var(--color-stone-950));
  }

  .about-content {
    color: rgb(var(--color-stone-950));
  }
</style>

<script>
  import gsap from "gsap";
  import ScrollTrigger from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  const aboutSection = document.querySelector(".about-content") as HTMLElement;
  const aboutWords = document.querySelectorAll(
    ".about-word"
  ) as NodeListOf<HTMLElement>;

  gsap.to(aboutWords, {
    opacity: 1,
    stagger: 0.05,
    scrollTrigger: {
      trigger: aboutSection,
      start: "top 80%",
      end: "bottom 40%",
      scrub: 1,
    },
  });
</script>
