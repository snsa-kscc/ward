---
import { cn } from "@/lib/utils";
import "@/styles/globals.css";
import { TailwindIndicator } from "../components/TailwindIndicator";
import { Toaster } from "@/components/ui/toaster";
import { ClientRouter } from "astro:transitions";

interface Props {
  lang?: string;
  title: string;
  description?: string;
}

const { lang, title, description } = Astro.props;
const isAdmin = Astro.url.pathname.includes("admin");
const cleanDescription = description?.replaceAll("__", "");
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={cleanDescription} />
    <title>{title}</title>
    {!isAdmin && <ClientRouter fallback="none" />}
    <script>
      import gsap from "gsap";
      import ScrollTrigger from "gsap/ScrollTrigger";
      gsap.registerPlugin(ScrollTrigger);
      window.gsap = gsap;
      window.ScrollTrigger = ScrollTrigger;
    </script>
  </head>
  <body class={cn("bg-zinc-900 text-slate-100 tracking-tighter", { "font-[system-ui] tracking-normal": isAdmin })}>
    <slot />
    {!isAdmin && <div class="pointer-events-none fixed inset-0 z-10 h-full w-full bg-[url('/noise.png')] bg-repeat opacity-[0.03]" />}
    <TailwindIndicator />
    <Toaster client:load />
  </body>
</html>
