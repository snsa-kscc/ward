---
import Header from "@/components/Header.astro";
import Layout from "@/layouts/Layout.astro";
import Footer from "@/components/Footer.astro";
import { db } from "db";
import { eq, asc } from "drizzle-orm";
import { portfolio, store, pages } from "db/schema";
import type { StoreData } from "@/types/global";
import { Image } from "astro:assets";
import { formatParagraph, getLocalizedValue } from "@/lib/utils";

const { id, locale } = Astro.params;

const [pagesData, storeData, data] = await Promise.all([
  db
    .select()
    .from(pages)
    .where(eq(pages.lang, locale!))
    .orderBy(asc(pages.name)),
  db.select().from(store).where(eq(store.lang, locale!)),
  db.select().from(portfolio).where(eq(portfolio.slug, id!)),
]);

const storeDataMap: StoreData = storeData.reduce((acc, cur) => {
  acc[cur.key as string] = cur.value as string;

  return acc;
}, {} as StoreData);

if (!data[0]) {
  return Astro.redirect(`/404?locale=${locale}`);
}
const parsedDescription = data[0].content
  ? getLocalizedValue(data[0].content, locale!)
  : "";
const parsedSubtitle = data[0].subtitle
  ? getLocalizedValue(data[0].subtitle, locale!)
  : "";
---

<Layout
  lang={locale}
  title=`${data[0].title!} — WARD`
  description={parsedDescription}
>
  <Header lang={locale!} id={id} links={storeDataMap.navbarLinks} />
  <h1
    class="title container py-42 text-right text-[clamp(var(--text-5xl),var(--text-9xl))] font-medium text-stone-950"
  >
    {
      data[0].title
        ?.split(/(\s)/)
        .map((w) => (
          <span class="relative inline-block overflow-hidden">
            {w === " " ? (
              <span>&nbsp;</span>
            ) : (
              w
                .split("")
                .map((c) => (
                  <span class="inline-block translate-y-full will-change-transform">
                    {c}
                  </span>
                ))
            )}
          </span>
        ))
    }
  </h1>
  <div class="portfolio-sticky-wrapper my-20 w-full overflow-hidden">
    <div
      class="portfolio-item-wrapper flex w-max items-center gap-16 px-40 opacity-0 will-change-transform"
    >
      {
        JSON.parse(data[0].media!).map((media: string, index: number) => {
          return (
            <div>
              <Image
                class="max-h-[80vh] w-full rounded-2xl"
                src={`/assets/portfolio/${media}`}
                alt={`${data[0]?.title ?? "Portfolio Image"}-${index + 1}`}
                width={1500}
                height={2000}
                loading="eager"
              />
            </div>
          );
        })
      }
    </div>
  </div>
  <div class="portfolio-content container pt-20 opacity-0">
    <div class="flex items-start justify-between gap-8">
      {
        parsedSubtitle && (
          <div class="text-3xl font-bold">
            <p>{parsedSubtitle}</p>
          </div>
        )
      }
      <div
        class="w-1/2"
        set:html={formatParagraph(
          data[0].content ? JSON.parse(data[0].content)[locale!] || "" : ""
        )}
      />
    </div>
  </div>
  <Footer locale={locale!} storeData={storeDataMap} pagesData={pagesData} />
</Layout>
<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const headerWords = document.querySelectorAll(".title>span>span");
  const portfolioItemsWrapper = document.querySelector(
    ".portfolio-item-wrapper"
  ) as HTMLElement;
  const portfolioStickyWrapper = document.querySelector(
    ".portfolio-sticky-wrapper"
  );

  const tl = gsap.timeline();
  tl.to(headerWords, {
    y: 0,
    stagger: 0.05,
  });
  tl.fromTo(
    portfolioItemsWrapper,
    {
      opacity: 0,
      yPercent: 10,
    },
    {
      opacity: 1,
      yPercent: 0,
      duration: 0.5,
      ease: "none",
    }
  );
  tl.to(
    ".portfolio-content",
    {
      opacity: 1,
      duration: 0.5,
      ease: "none",
    },
    "-=0.3"
  );
  const scrollTl = gsap.timeline({
    scrollTrigger: {
      trigger: portfolioStickyWrapper,
      pin: true,
      scrub: 1,
      start: "top 10%",
      end: () =>
        "+=" + (portfolioItemsWrapper.scrollWidth - window.innerWidth + 100),
      invalidateOnRefresh: true,
    },
  });

  scrollTl.to(
    portfolioItemsWrapper,
    {
      x: () => -(portfolioItemsWrapper.scrollWidth - window.innerWidth + 100),
      ease: "none",
      duration: 0.8,
    },
    0.1
  );
  scrollTl.to({}, { duration: 0.1 });
</script>
