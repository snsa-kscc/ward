---
import { Image } from "astro:assets";

export type SpecialityItem = {
  id: number;
  item: string | null;
  media?: string | null;
};

type Props = {
  title?: string;
  items: SpecialityItem[];
};

const { title = "Specialities", items } = Astro.props as Props;
---

<section class="my-[clamp(20,30)]">
  <div class="container px-4 py-16">
    <h2
      class="text-[clamp(var(--text-xl),var(--text-5xl))] leading-tight font-bold"
    >
      {title}
    </h2>

    {
      items.length ? (
        <div class="mt-12 flex items-center justify-between gap-8 text-[clamp(var(--text-lg),var(--text-2xl))] font-medium">
          {items.map((s) => (
            <div class="flex flex-col gap-4">
              {s.media ? (
                <Image
                  src={`/assets/specialities/${s.media}`}
                  alt={s.item ?? "Speciality"}
                  class="rounded-lg object-cover"
                  width={100}
                  height={100}
                  loading="lazy"
                />
              ) : null}
              <span>{s.item}</span>
            </div>
          ))}
        </div>
      ) : (
        <p class="mt-12 opacity-70">No specialities yet.</p>
      )
    }
  </div>
</section>
