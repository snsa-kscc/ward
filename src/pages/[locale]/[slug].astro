---
import Header from "@/components/Header.astro";
import Layout from "@/layouts/Layout.astro";
import Footer from "@/components/Footer.astro";
import { db } from "db";
import { eq, asc } from "drizzle-orm";
import { pages, store } from "db/schema";
import type { StoreData } from "@/types/global";
import { formatParagraph } from "@/lib/utils";

const { locale, slug } = Astro.params;

const [allPagesData, storeData] = await Promise.all([
  db.select().from(pages).orderBy(asc(pages.name)),
  db.select().from(store).where(eq(store.lang, locale!)),
]);
const storeDataMap: StoreData = storeData.reduce((acc, cur) => {
  acc[cur.key as string] = cur.value as string;

  return acc;
}, {} as StoreData);

const pagesData = allPagesData.filter((page) => page.lang === locale);
const data = pagesData.filter((page) => page.slug === slug);

if (!data[0]) {
  return Astro.redirect(`/404?locale=${locale}`);
}
---

<Layout
  lang={locale}
  title=`${data[0].title!} — WARD`
  description={data[0].content || ""}
>
  <Header lang={locale!} slug={slug} links={storeDataMap.navbarLinks} pagesData={allPagesData} />
  <div class="container px-6">
    <div
      class="mt-40 py-20 text-right text-[clamp(var(--text-5xl),var(--text-11xl))] font-bold md:py-40"
    >
      {data[0].title}
    </div>
    <div class="w-full py-10 text-lg md:w-2/3 md:py-20 md:text-xl">
      <p set:html={formatParagraph(data[0].content || "")} />
    </div>
  </div>
  <Footer locale={locale!} storeData={storeDataMap} pagesData={pagesData} />
</Layout>
