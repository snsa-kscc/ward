---
import Header from "@/components/Header.astro";
import Layout from "@/layouts/Layout.astro";
import Footer from "@/components/Footer.astro";
import { db } from "db";
import { eq, asc } from "drizzle-orm";
import { portfolio, store, pages } from "db/schema";
import type { StoreData } from "@/types/global";
import { Image } from "astro:assets";
import { formatParagraph } from "@/lib/utils";

const { id, locale } = Astro.params;

const [pagesData, storeData, data] = await Promise.all([
  db
    .select()
    .from(pages)
    .where(eq(pages.lang, locale!))
    .orderBy(asc(pages.name)),
  db.select().from(store).where(eq(store.lang, locale!)),
  db.select().from(portfolio).where(eq(portfolio.slug, id!)),
]);

const storeDataMap: StoreData = storeData.reduce((acc, cur) => {
  acc[cur.key as string] = cur.value as string;

  return acc;
}, {} as StoreData);

if (!data[0]) {
  return Astro.redirect(`/404?locale=${locale}`);
}
const parsedDescription = data[0].content
  ? JSON.parse(data[0].content)[locale!]
  : "";
let parsedSubtitle = "";
if (data[0].subtitle) {
  const subtitleObject = JSON.parse(data[0].subtitle!);
  parsedSubtitle = subtitleObject[locale!] || "";
}
---

<style>
  .loading-overlay {
    position: fixed;
    pointer-events: none;
    inset: 0;
    z-index: 100;
  }
  .loading-overlay.js-loaded {
    visibility: hidden;
    opacity: 0;
  }
</style>

<Layout
  lang={locale}
  title=`${data[0].title!} — WARD`
  description={parsedDescription}
>
  <div class="loading-overlay bg-zinc-900"></div>
  <Header lang={locale!} id={id} links={storeDataMap.navbarLinks} />
  <h1 class="title text-12xl container py-20 text-right font-bold">
    {
      data[0].title
        ?.split(/(\s)/)
        .map((w) => (
          <span class="relative inline-block overflow-hidden">
            {w === " " ? (
              <span>&nbsp;</span>
            ) : (
              w
                .split("")
                .map((c) => (
                  <span class="inline-block translate-y-full will-change-transform">
                    {c}
                  </span>
                ))
            )}
          </span>
        ))
    }
  </h1>
  {
    parsedSubtitle && (
      <h2 class="subtitle container text-right text-4xl font-light opacity-80">
        {parsedSubtitle}
      </h2>
    )
  }
  <div
    class="portfolio-item-wrapper my-20 flex min-w-max items-center gap-16 overflow-x-auto px-40 will-change-transform"
  >
    {
      JSON.parse(data[0].media!).map((media: string, index: number) => {
        return (
          <div>
            <Image
              class="max-h-[80vh] w-full"
              src={`/assets/portfolio/${media}`}
              alt={`${data[0].title}-${index + 1}`}
              width={1500}
              height={2000}
              loading="eager"
            />
          </div>
        );
      })
    }
  </div>
  <div class="portfolio-item-description container pt-20">
    <p
      class="w-1/2"
      set:html={formatParagraph(
        data[0].content ? JSON.parse(data[0].content)[locale!] || "" : ""
      )}
    />
  </div>
  <Footer locale={locale!} storeData={storeDataMap} pagesData={pagesData} />
</Layout>
<script>
  import gsap from "gsap";
  const headerWords = document.querySelectorAll(".title>span>span");
  const portfolioItemDescription = document.querySelector(
    ".portfolio-item-description"
  );
  const portfolioItemsWrapper = document.querySelector(
    ".portfolio-item-wrapper"
  ) as HTMLElement;

  document.addEventListener("DOMContentLoaded", () => {
    const loadingOverlay = document.querySelector(".loading-overlay");
    loadingOverlay?.classList.add("js-loaded");
  });
  if (window.scrollY === 0) {
    document.body.classList.add("overflow-hidden");
    setTimeout(() => {
      document.body.classList.remove("overflow-hidden");
    }, 1500);
  }

  const tl = gsap.timeline();
  tl.to(headerWords, {
    y: 0,
    stagger: 0.05,
  });
  tl.from(portfolioItemsWrapper, {
    y: 75,
    opacity: 0,
    duration: 0.7,
    ease: "none",
  });
  gsap.to(portfolioItemsWrapper, {
    x: () => -(portfolioItemsWrapper.scrollWidth - window.innerWidth),
    scrollTrigger: {
      trigger: portfolioItemsWrapper,
      pin: true,
      scrub: 0.7,
      start: "top 10%",
      end: () => "+=" + (portfolioItemsWrapper.scrollWidth - window.innerWidth),
      invalidateOnRefresh: true,
    },
  });
  gsap.from(portfolioItemDescription, {
    y: 75,
    opacity: 0,
    duration: 0.7,
    ease: "power2.out",
    scrollTrigger: {
      trigger: portfolioItemDescription,
      start: "top 80%",
    },
  });
</script>
