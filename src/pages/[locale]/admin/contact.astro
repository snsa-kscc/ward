---
import Layout from "@/layouts/Layout.astro";
import AdminNavbar from "@/components/admin/AdminNavbar.astro";
import { db } from "db";
import { store } from "db/schema";
import { and, eq } from "drizzle-orm";
import { Label } from "@/components/ui/label";
import { Input } from "@/components/ui/input";
import { Button } from "@/components/ui/button";
import { upsertStoreData } from "@/lib/store";

const { locale } = Astro.params;

const res = await db
  .select()
  .from(store)
  .where(and(eq(store.section, "footer"), eq(store.lang, locale!)));

const dict = res.reduce(
  (acc, cur) => {
    acc[cur.key as string] = cur.value as string;
    return acc;
  },
  {} as Record<string, string>
);

if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();
  const result = await upsertStoreData({
    formData,
    section: "footer",
    locale: locale!,
    fileKeys: [],
  });

  if (result.success) {
    return Astro.redirect(`/${locale}/admin/contact?update=success`);
  } else {
    return Astro.redirect(`/${locale}/admin/contact?update=error`);
  }
}
---

<Layout lang={locale} title="Contact">
  <AdminNavbar lang={locale!} />
  <div class="container p-8">
    <h1 class="title py-20 text-3xl">Contact</h1>
    <form
      method="POST"
      enctype="multipart/form-data"
      class="flex flex-col items-start gap-4"
    >
      <Label htmlFor="contactHook1">Contact Hook 1</Label>
      <Input
        type="text"
        name="contactHook1"
        required
        className="bg-transparent text-white"
        defaultValue={dict.contactHook1}
      />
      <Label htmlFor="contactHook2">Contact Hook 2</Label>
      <Input
        type="text"
        name="contactHook2"
        required
        className="bg-transparent text-white"
        defaultValue={dict.contactHook2}
      />
      <Label htmlFor="contactKey">Contact Key</Label>
      <Input
        type="text"
        name="contactKey"
        required
        className="bg-transparent text-white"
        defaultValue={dict.contactKey}
      />
      <div class="flex w-full flex-col items-center gap-4 md:flex-row">
        <Label htmlFor="contactName">Name</Label>
        <Input
          type="text"
          name="contactName"
          required
          className="bg-transparent text-white"
          defaultValue={dict.contactName}
        />
        <Label htmlFor="contactEmail">Email</Label>
        <Input
          type="email"
          name="contactEmail"
          required
          className="bg-transparent text-white"
          defaultValue={dict.contactEmail}
        />
        <Label htmlFor="contactPhone">Phone</Label>
        <Input
          type="tel"
          name="contactPhone"
          required
          className="bg-transparent text-white"
          defaultValue={dict.contactPhone}
        />
        <Label htmlFor="contactAddress">Address</Label>
        <Input
          type="text"
          name="contactAddress"
          required
          className="bg-transparent text-white"
          defaultValue={dict.contactAddress}
        />
      </div>
      <Label htmlFor="infoKey">Info Key</Label>
      <Input
        type="text"
        name="infoKey"
        required
        className="bg-transparent text-white"
        defaultValue={dict.infoKey}
      />
      <Label htmlFor="newsletterKey">Newsletter Key</Label>
      <Input
        type="text"
        name="newsletterKey"
        required
        className="bg-transparent text-white"
        defaultValue={dict.newsletterKey}
      />
      <div class="flex w-full flex-col items-center gap-4 md:flex-row">
        <Label htmlFor="newsletterButton">Newsletter Button</Label>
        <Input
          type="text"
          name="newsletterButton"
          required
          className="bg-transparent text-white"
          defaultValue={dict.newsletterButton}
        />
        <Label htmlFor="newsletterDisclaimer">Newsletter Disclaimer</Label>
        <Input
          type="text"
          name="newsletterDisclaimer"
          required
          className="bg-transparent text-white"
          defaultValue={dict.newsletterDisclaimer}
        />
      </div>
      <Label htmlFor="copyright">Copyright</Label>
      <Input
        type="text"
        name="copyright"
        required
        className="bg-transparent text-white"
        defaultValue={dict.copyright}
      />
      <Button type="submit" variant="secondary">send</Button>
    </form>
  </div>
  <script>
    import { toast } from "@/hooks/use-toast";

    const urlParams = new URLSearchParams(window.location.search);
    const updateStatus = urlParams.get("update");

    if (updateStatus === "success") {
      toast({
        title: "Success",
        description: "Update successful!",
      });
    } else if (updateStatus === "error") {
      toast({
        title: "Error",
        description: "Update failed.",
        variant: "destructive",
      });
    }
  </script>
</Layout>
