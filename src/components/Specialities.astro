---
export type SpecialityItem = {
  id: number;
  item: string | null;
  media?: string | null;
};

type Props = {
  items: SpecialityItem[];
};

const { items } = Astro.props as Props;
---

<section class="my-[clamp(20,30)]">
  <div class="container px-4 py-16">
    {
      items.length ? (
        <div class="mt-12" data-specialities-list>
          {items.map((s, index) => (
            <div
              class="group container px-4"
              data-speciality-trigger
              data-index={index}
              data-media={s.media ?? ""}
            >
              <div
                class={`flex items-start justify-between gap-6 border-stone-200 py-[clamp(4,8)] lg:ml-auto lg:w-1/2 ${index === 0 ? "border-t " : ""}border-b`}
              >
                <p class="min-w-0 flex-1 text-[clamp(var(--text-3xl),var(--text-5xl))] leading-[1.05] font-semibold text-stone-950 transition-colors duration-300 group-hover:text-stone-500">
                  {s.item}
                </p>
                <span class="shrink-0 pt-[clamp(3,8)] text-[clamp(var(--text-sm),var(--text-base))] leading-none font-semibold text-stone-500 tabular-nums">
                  {String(index + 1).padStart(2, "0")}
                </span>
              </div>
            </div>
          ))}
        </div>
      ) : (
        <p class="mt-12 opacity-70">No specialities yet.</p>
      )
    }
  </div>
</section>

<div
  class="specialities-preview fixed top-0 left-0 hidden overflow-hidden rounded-xl bg-stone-100/60 lg:block"
  data-specialities-preview
>
  <img
    alt=""
    class="specialities-preview-img absolute inset-0 h-full w-full object-cover opacity-0"
    data-preview-a
    loading="lazy"
  />
  <img
    alt=""
    class="specialities-preview-img absolute inset-0 h-full w-full object-cover opacity-0"
    data-preview-b
    loading="lazy"
  />
</div>

<style>
  .specialities-preview {
    aspect-ratio: 4 / 3;
    width: min(360px, 70vw);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    z-index: 60;
    transition:
      opacity 250ms ease,
      visibility 250ms ease;
    will-change: opacity, transform;
  }

  .specialities-preview.is-visible {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .specialities-preview-img {
    transition: opacity 500ms ease;
    will-change: opacity;
  }

  @media (prefers-reduced-motion: reduce) {
    .specialities-preview,
    .specialities-preview-img {
      transition-duration: 0ms;
    }
  }
</style>

<script>
  const listEl = document.querySelector(
    "[data-specialities-list]"
  ) as HTMLElement | null;
  const previewEl = document.querySelector(
    "[data-specialities-preview]"
  ) as HTMLElement | null;
  const triggers = Array.from(
    document.querySelectorAll("[data-speciality-trigger]")
  ) as HTMLElement[];

  const imgA = document.querySelector(
    "[data-preview-a]"
  ) as HTMLImageElement | null;
  const imgB = document.querySelector(
    "[data-preview-b]"
  ) as HTMLImageElement | null;

  if (listEl && previewEl && imgA && imgB && triggers.length) {
    const mediaBasePath = "/assets/specialities/";

    const preloaded = new Set<string>();
    triggers
      .map((t) => t.dataset.media ?? "")
      .filter(Boolean)
      .forEach((m) => {
        const src = `${mediaBasePath}${m}`;
        if (preloaded.has(src)) return;
        preloaded.add(src);
        const img = new Image();
        img.decoding = "async";
        img.src = src;
      });

    let activeSrc = "";
    let front = imgA;
    let back = imgB;

    let lastX = 0;
    let lastY = 0;
    let isOverPreview = false; // Used only for hide logic, not position updates
    let isReducedMotion = false;

    // Linear interpolation variables
    let currentX = 0;
    let currentY = 0;
    let targetX = 0;
    let targetY = 0;
    let animationId: number | null = null;

    try {
      isReducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches;
    } catch {
      isReducedMotion = false;
    }

    const setVisible = (visible: boolean) => {
      previewEl.classList.toggle("is-visible", visible);
    };

    const clamp = (value: number, min: number, max: number) => {
      return Math.min(Math.max(value, min), max);
    };

    const lerp = (start: number, end: number, factor: number) => {
      return start + (end - start) * factor;
    };

    const animate = () => {
      const smoothingFactor = isReducedMotion ? 1 : 0.15;

      currentX = lerp(currentX, targetX, smoothingFactor);
      currentY = lerp(currentY, targetY, smoothingFactor);

      const offset = 18;
      const padding = 12;
      const rect = previewEl.getBoundingClientRect();
      const maxX = window.innerWidth - rect.width - padding;
      const maxY = window.innerHeight - rect.height - padding;

      const x = clamp(currentX + offset, padding, maxX);
      const y = clamp(currentY - rect.height / 2, padding, maxY);
      previewEl.style.transform = `translate3d(${x}px, ${y}px, 0)`;

      // Continue animation if not at target
      const distance = Math.sqrt(
        Math.pow(targetX - currentX, 2) + Math.pow(targetY - currentY, 2)
      );

      if (distance > 0.5 && !isReducedMotion) {
        animationId = requestAnimationFrame(animate);
      } else {
        animationId = null;
      }
    };

    const positionPreview = (clientX: number, clientY: number) => {
      targetX = clientX;
      targetY = clientY;

      if (isReducedMotion) {
        currentX = targetX;
        currentY = targetY;
        animate();
      } else if (!animationId) {
        animationId = requestAnimationFrame(animate);
      }
    };

    const crossfadeTo = (nextSrc: string) => {
      if (!nextSrc || nextSrc === activeSrc) return;

      activeSrc = nextSrc;

      // Clear any pending onload to prevent stale swaps
      back.onload = null;
      back.src = nextSrc;

      const swap = () => {
        // Only swap if this is still the active source
        if (back.src.endsWith(activeSrc.split("/").pop() || "")) {
          front.style.opacity = "0";
          back.style.opacity = "1";
          const tmp = front;
          front = back;
          back = tmp;
        }
      };

      if (back.complete) {
        requestAnimationFrame(swap);
      } else {
        back.onload = () => {
          requestAnimationFrame(swap);
          back.onload = null;
        };
      }
    };

    const show = () => {
      setVisible(true);
      currentX = lastX;
      currentY = lastY;
      targetX = lastX;
      targetY = lastY;
      positionPreview(lastX, lastY);
    };

    const hideIfNotHovering = () => {
      const el = document.elementFromPoint(lastX, lastY);
      const stillOverTrigger = !!el?.closest("[data-speciality-trigger]");
      const stillOverPreview = !!el?.closest("[data-specialities-preview]");
      isOverPreview = stillOverPreview;
      // Use isOverPreview to satisfy TypeScript
      void isOverPreview;
      if (!stillOverTrigger && !stillOverPreview) {
        setVisible(false);
        if (animationId) {
          cancelAnimationFrame(animationId);
          animationId = null;
        }
      }
    };

    window.addEventListener(
      "mousemove",
      (e) => {
        lastX = e.clientX;
        lastY = e.clientY;
        if (previewEl.classList.contains("is-visible")) {
          positionPreview(lastX, lastY);
        }
      },
      { passive: true }
    );

    window.addEventListener(
      "scroll",
      () => {
        if (previewEl.classList.contains("is-visible")) {
          requestAnimationFrame(hideIfNotHovering);
        }
      },
      { passive: true }
    );

    listEl.addEventListener(
      "mousemove",
      (e) => {
        lastX = e.clientX;
        lastY = e.clientY;
        positionPreview(lastX, lastY);
      },
      { passive: true }
    );

    listEl.addEventListener(
      "mouseleave",
      () => {
        requestAnimationFrame(hideIfNotHovering);
      },
      { passive: true }
    );

    previewEl.addEventListener(
      "mouseenter",
      () => {
        isOverPreview = true;
      },
      { passive: true }
    );

    previewEl.addEventListener(
      "mouseleave",
      () => {
        isOverPreview = false;
      },
      { passive: true }
    );

    triggers.forEach((el) => {
      el.addEventListener(
        "mousemove",
        (e) => {
          lastX = e.clientX;
          lastY = e.clientY;
          positionPreview(lastX, lastY);
        },
        { passive: true }
      );

      el.addEventListener(
        "mouseenter",
        () => {
          const media = el.dataset.media ?? "";
          if (!media) return;
          show();
          const nextSrc = `${mediaBasePath}${media}`;
          if (!activeSrc) {
            front.src = nextSrc;
            front.style.opacity = "1";
            activeSrc = nextSrc;
          } else {
            crossfadeTo(nextSrc);
          }
        },
        { passive: true }
      );

      el.addEventListener(
        "mouseleave",
        () => {
          if (isReducedMotion) {
            hideIfNotHovering();
          } else {
            requestAnimationFrame(hideIfNotHovering);
          }
        },
        { passive: true }
      );
    });
  }
</script>
