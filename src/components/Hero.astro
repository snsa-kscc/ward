---
import { Image } from "astro:assets";
import type { StoreData } from "@/types/global";

type Props = {
  data: StoreData;
};

const { data } = Astro.props;

const titleLines = data.title.split("__").map((line) => line.trim());
---

<section class="container mt-[clamp(36,38)]">
  <div class="flex flex-col items-center justify-center py-[clamp(24,38)]">
    <div
      class="hero-title-container text-[clamp(var(--text-5xl),var(--text-9xl))] leading-none font-medium"
    >
      {
        titleLines.map((line, index) => (
          <div class="hero-line-wrapper overflow-hidden" data-line={index}>
            <div class="hero-line">{line}</div>
          </div>
        ))
      }
    </div>
  </div>
  {
    data.featureMedia && (
      <Image
        src={`/assets/${data.featureMedia}`}
        alt={data.featureMedia}
        width={1500}
        height={2000}
        loading="eager"
        class="mt-24 h-[100vmin] w-full"
      />
    )
  }
</section>

<style>
  .hero-line-wrapper {
    overflow: hidden;
    will-change: transform;
  }

  .hero-line {
    will-change: transform;
  }
</style>

<script>
  import gsap from "gsap";

  const heroLines = document.querySelectorAll(
    ".hero-line"
  ) as NodeListOf<HTMLElement>;

  gsap.from(heroLines, {
    duration: 1,
    yPercent: 100,
    opacity: 0,
    ease: "power2.out",
    stagger: 0.3,
    delay: 0.5,
  });
</script>
