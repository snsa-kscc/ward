---
import { cn } from "@/lib/utils";
import "@/styles/globals.css";
import { TailwindIndicator } from "@/components/admin/TailwindIndicator";
import { Toaster } from "@/components/ui/toaster";

interface Props {
  lang?: string;
  title: string;
  description?: string;
}

const { lang, title, description } = Astro.props;
const isAdmin = Astro.url.pathname.includes("admin");
const sanitizedtitle = title.replaceAll("__", "");
const cleanedDescription = description?.replaceAll("__", "") || "";
const sanitizedDescription =
  cleanedDescription.length > 100
    ? cleanedDescription.slice(0, 100) + "..."
    : cleanedDescription;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={sanitizedDescription} />
    <title>{sanitizedtitle}</title>
    <!-- <style is:global>
      html.lenis,
      body.lenis {
        height: auto;
      }
      .lenis.lenis-smooth {
        scroll-behavior: auto !important;
      }
      .lenis.lenis-smooth [data-lenis-prevent] {
        overscroll-behavior: contain;
      }
      .lenis.lenis-stopped {
        overflow: hidden;
      }
      .lenis.lenis-scrolling iframe {
        pointer-events: none;
      }
    </style> -->
  </head>
  <body
    class={cn("bg-stone-50 text-stone-950", {
      "font-[system-ui] tracking-normal bg-black text-white": isAdmin,
    })}
  >
    <slot />
    <TailwindIndicator />
    <Toaster client:load />
    <script>
      import Lenis from "lenis";
      import gsap from "gsap";
      import { ScrollTrigger } from "gsap/ScrollTrigger";
      import "@/scripts/sig.js";

      // Only initialize Lenis on non-admin routes
      if (!window.location.pathname.includes("admin")) {
        const lenis = new Lenis();
        lenis.on("scroll", ScrollTrigger.update);

        gsap.ticker.add((time) => {
          lenis.raf(time * 1000);
        });

        gsap.ticker.lagSmoothing(0);
      }
    </script>
  </body>
</html>
