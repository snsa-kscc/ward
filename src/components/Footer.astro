---
import { NewsletterSubscribe } from "./NewsletterSubscribe";
import type { StoreData } from "@/types/global";

type Props = {
  locale: string;
  storeData: StoreData;
  pagesData: {
    title: string | null;
    slug: string | null;
  }[];
};

const { locale, storeData, pagesData } = Astro.props;
---

<footer class="mt-[clamp(40,72)]">
  <div
    class="bar-char-wrapper container px-4 pb-[clamp(10,20)] text-[clamp(var(--text-3xl),var(--text-8xl))] font-bold"
  >
    {
      storeData.contactHook1.split("").map((char: string) => {
        if (char === " ") {
          return <span class="bar-char inline-block">&nbsp;</span>;
        }
        return <span class="bar-char inline-block">{char}</span>;
      })
    }
  </div>
  <div
    id={storeData.navbarLinks
      .split(",")
      .map((link) => link.trim())
      .at(-1)}
    class="container my-[clamp(10,20)] px-4"
  >
    <div class="flex flex-col justify-between gap-16 sm:flex-row">
      <div class="flex basis-1/3 gap-16">
        <div class="basis-1/2">
          <p
            class="pb-8 text-[clamp(var(--text-xl),var(--text-2xl))] font-bold"
          >
            {storeData.contactKey}
          </p>
          <p>{storeData.contactName}</p>
          <p>
            <a
              href={`mailto:${storeData.contactEmail}`}
              class="relative pb-0.5 transition-colors duration-300 after:absolute after:bottom-0 after:left-0 after:h-0.5 after:w-0 after:bg-current after:transition-all after:duration-300 after:ease-in-out hover:text-stone-500 hover:after:w-full"
              >{storeData.contactEmail}</a
            >
          </p>
          <p>
            tel: <a
              href={`tel:${storeData.contactPhone.replaceAll(" ", "")}`}
              class="relative pb-0.5 transition-colors duration-300 after:absolute after:bottom-0 after:left-0 after:h-0.5 after:w-0 after:bg-current after:transition-all after:duration-300 after:ease-in-out hover:text-stone-500 hover:after:w-full"
              >{storeData.contactPhone}</a
            >
          </p>
          <p>{storeData.contactAddress}</p>
        </div>
        <div class="basis-1/2">
          <p
            class="pb-8 text-[clamp(var(--text-xl),var(--text-2xl))] font-bold"
          >
            {storeData.infoKey}
          </p>
          {
            pagesData.map((page) => (
              <div class="">
                <a
                  href={`/${locale !== "en" ? `${locale}/` : ""}${page.slug}`}
                  class="relative pb-0.5 transition-colors duration-300 after:absolute after:bottom-0 after:left-0 after:h-0.5 after:w-0 after:bg-current after:transition-all after:duration-300 after:ease-in-out hover:text-stone-500 hover:after:w-full"
                >
                  {page.title}
                </a>
              </div>
            ))
          }
        </div>
      </div>
      <div class="basis-1/3">
        <p class="pb-8 text-[clamp(var(--text-xl),var(--text-2xl))] font-bold">
          {storeData.newsletterKey}
        </p>
        <NewsletterSubscribe
          client:load
          button={storeData.newsletterButton}
          lang={locale}
        />
        <p class="pt-6 text-xs" set:html={storeData.newsletterDisclaimer} />
      </div>
    </div>
  </div>
  <div
    class="footer-wrapper container px-4 pb-[clamp(10,15)] text-right text-[clamp(var(--text-6xl),var(--text-20xl))] font-bold"
  >
    {
      storeData.contactHook2.split("").map((char: string) => {
        if (char === " ") {
          return <span class="cta-char inline-block">&nbsp;</span>;
        }
        return <span class="cta-char inline-block">{char}</span>;
      })
    }
  </div>
  <div
    class="container pb-[clamp(10,20)] text-[clamp(var(--text-xl),var(--text-2xl))] font-bold"
  >
    <p>{`© ${new Date().getFullYear()} ${storeData.copyright}`}</p>
  </div>
</footer>

<button
  type="button"
  class="fixed right-4 bottom-4 z-50 inline-flex h-14 w-14 items-center justify-center rounded-full ring-1 ring-stone-950"
  style="opacity: 0; transform: translateY(20px) scale(0.9); visibility: hidden;"
  aria-label="Scroll to top"
  data-scroll-to-top
  data-scroll-to-top-visible="false"
>
  <img src="/arrow-up.svg" alt="Arrow up" class="h-6 w-6" />
</button>

<style>
  .bar-char {
    will-change: filter, transform;
  }
</style>

<script>
  import { gsap } from "gsap";
  import ScrollTrigger from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  function initFooterAnimation() {
    const footerChars = document.querySelectorAll(
      ".cta-char"
    ) as NodeListOf<HTMLElement>;
    const barChars = document.querySelectorAll(
      ".bar-char"
    ) as NodeListOf<HTMLElement>;

    if (!barChars.length && !footerChars.length) return;

    if (barChars.length) {
      gsap.fromTo(
        barChars,
        {
          scaleY: 0.1,
          scaleX: 1.8,
          filter: "blur(10px) brightness(50%)",
        },
        {
          ease: "power1.out",
          scaleY: 1,
          scaleX: 1,
          filter: "blur(0px) brightness(100%)",
          stagger: 0.05,
          scrollTrigger: {
            trigger: ".bar-char-wrapper",
            start: "top 80%",
            end: "top center",
            scrub: 1,
          },
        }
      );
    }

    if (footerChars.length) {
      gsap.fromTo(
        footerChars,
        {
          opacity: 0,
          skewX: -20,
          willChange: "filter, transform",
          filter: "blur(8px)",
        },
        {
          ease: "sine",
          opacity: 1,
          skewX: 0,
          filter: "blur(0px)",
          stagger: 0.04,
          scrollTrigger: {
            trigger: ".footer-wrapper",
            start: "top 80%",
            once: true,
          },
        }
      );
    }
  }

  function initScrollToTop() {
    const button = document.querySelector(
      "[data-scroll-to-top]"
    ) as HTMLButtonElement | null;

    if (!button) return;

    let flashAnimation: Animation | null = null;

    const startFlash = () => {
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

      flashAnimation?.cancel();
      flashAnimation = button.animate(
        [{ opacity: 1 }, { opacity: 0.2 }, { opacity: 1 }],
        {
          duration: 5000,
          iterations: Infinity,
          easing: "ease-in-out",
        }
      );
    };

    const stopFlash = () => {
      flashAnimation?.cancel();
      flashAnimation = null;
    };

    const setVisible = (visible: boolean) => {
      const isVisible = button.dataset.scrollToTopVisible === "true";
      if (isVisible === visible) return;

      button.dataset.scrollToTopVisible = visible ? "true" : "false";

      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        button.style.opacity = visible ? "1" : "0";
        button.style.transform = visible
          ? "translateY(0) scale(1)"
          : "translateY(20px) scale(0.9)";
        button.style.visibility = visible ? "visible" : "hidden";
        if (visible) startFlash();
        else stopFlash();
        return;
      }

      if (visible) {
        button.style.visibility = "visible";
        gsap.to(button, {
          opacity: 1,
          y: 0,
          scale: 1,
          duration: 0.25,
          ease: "back.out(1.7)",
          onComplete: startFlash,
        });
      } else {
        stopFlash();
        gsap.to(button, {
          opacity: 0,
          y: 20,
          scale: 0.7,
          duration: 0.2,
          ease: "power2.in",
          onComplete: () => {
            button.style.visibility = "hidden";
          },
        });
      }
    };

    const updateVisibility = () => {
      const scrollTop = window.scrollY || document.documentElement.scrollTop;
      const viewportHeight = window.innerHeight;
      const pageHeight = document.documentElement.scrollHeight;
      const distanceFromBottom = pageHeight - (scrollTop + viewportHeight);

      setVisible(distanceFromBottom <= 60);
    };

    button.addEventListener("click", () => {
      window.scrollTo({ top: 0, behavior: "smooth" });
    });

    window.addEventListener("scroll", updateVisibility, { passive: true });
    window.addEventListener("resize", updateVisibility);
    updateVisibility();
  }

  document.addEventListener("DOMContentLoaded", () => {
    initFooterAnimation();
    initScrollToTop();
  });
</script>
