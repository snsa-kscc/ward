---
import type { StoreData } from "@/types/global";

type Props = {
  data: StoreData;
};

const { data } = Astro.props;

const titleLines = data.title.split("__").map((line) => line.trim());
---

<section class="container mt-[clamp(36,38)] px-6">
  <div class="flex flex-col items-center justify-center py-[clamp(24,38)]">
    <h1
      class="hero-title-container text-left text-[clamp(var(--text-5xl),var(--text-9xl))] leading-none font-medium"
    >
      {
        titleLines.map((line, index) => (
          <div class="hero-line-wrapper overflow-hidden" data-line={index}>
            <div class="hero-line">{line}</div>
          </div>
        ))
      }
    </h1>
  </div>
</section>

<style>
  .hero-line-wrapper {
    overflow: hidden;
    will-change: transform;
  }

  .hero-line {
    will-change: transform;
    opacity: 0;
  }
</style>

<script>
  import gsap from "gsap";

  const heroLines = document.querySelectorAll(
    ".hero-line"
  ) as NodeListOf<HTMLElement>;

  gsap.fromTo(
    heroLines,
    { yPercent: 100, opacity: 0 },
    {
      duration: 1,
      yPercent: 0,
      opacity: 1,
      ease: "power2.out",
      stagger: 0.3,
      delay: 0.5,
    }
  );
</script>
