---
import Layout from "@/layouts/Layout.astro";
import AdminNavbar from "@/components/admin/AdminNavbar.astro";
import { db } from "db";
import { accolades } from "db/schema";
import { asc, eq } from "drizzle-orm";
import AccoladesManager from "@/components/admin/AccoladesManager";

const { locale } = Astro.params;
const accoladeData = await db
  .select()
  .from(accolades)
  .where(eq(accolades.lang, locale!))
  .orderBy(asc(accolades.order));
const items = accoladeData.map((item) => ({
  id: item.id,
  item: item.item!,
}));
---

<Layout lang={locale} title="Accolades Management">
  <AdminNavbar lang={locale!} />
  <div class="container px-8">
    <h1 class="title py-20 text-3xl">Accolades Management</h1>
    <AccoladesManager client:only="react" items={items} locale={locale!} />
  </div>
</Layout>
