---
import type { StoreData } from "@/types/global";
import { Image } from "astro:assets";

type Props = {
  storeDataMap: StoreData;
};

const { storeDataMap } = Astro.props;

// Create 3x3 grid configuration
const cells = Array.from({ length: 9 }).map((_, i) => ({
  id: i,
  row: Math.floor(i / 3),
  col: i % 3,
}));
---

<>
  <section
    class="js-picture-section relative h-[100vmin] w-full overflow-hidden"
  >
    <div class="grid h-full w-full grid-cols-3 grid-rows-3">
      {
        cells.map((cell) => (
          <div class="picture-cell relative h-[calc(100%+1px)] w-[calc(100%+1px)] overflow-hidden">
            <div class="picture-cell-inner h-full w-full">
              <Image
                src={`/assets/${storeDataMap.featureMedia}`}
                alt={
                  storeDataMap?.featureMedia
                    ?.split(".")
                    .slice(0, -1)
                    .join("-") || ""
                }
                class="absolute max-w-none object-cover"
                width={1900}
                height={2000}
                style={{
                  width: "300%",
                  height: "300%",
                  left: `${cell.col * -100}%`,
                  top: `${cell.row * -100}%`,
                }}
              />
            </div>
          </div>
        ))
      }
    </div>
  </section>
  {
    (
      <div class="h-[100vmin] w-full py-16">
        <video
          src={`/assets/${storeDataMap.reelMedia}`}
          autoplay
          loop
          muted
          playsinline
          class="h-full w-full object-cover"
          preload="metadata"
        />
      </div>
    )
  }
</>

<script>
  import gsap from "gsap";
  import ScrollTrigger from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const sections = document.querySelectorAll(
    ".js-picture-section"
  ) as NodeListOf<HTMLElement>;

  sections.forEach((section) => {
    const cells = section.querySelectorAll(".picture-cell-inner");

    // Set initial state
    gsap.set(cells, {
      clipPath: "inset(100%)", // Start hidden
    });

    gsap.to(cells, {
      clipPath: "inset(0%)", // Reveal
      duration: 1.5,
      ease: "power4.inOut",
      stagger: {
        grid: [3, 3],
        from: "random",
        amount: 0.5,
      },
      scrollTrigger: {
        trigger: section,
        start: "top 60%",
      },
    });
  });
</script>
