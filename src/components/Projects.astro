---
type Props = {
  locale: string;
  data: {
    media: string;
    title: string;
    slug: string;
  }[][];
  storeDataMap: {
    navbarLinks: string;
  };
};

const { locale, data, storeDataMap } = Astro.props;
---

<section
  id={storeDataMap.navbarLinks
    .split(",")
    .map((link) => link.trim())
    .at(0)}
  class="container relative grid grid-cols-3 gap-8 overflow-y-clip px-4"
>
  {
    data.map((part, index) => {
      const className = index === 1 ? "flex-col" : "flex-col-reverse column-reverse";
      return (
        <div class={`flex ${className} py-[10vh]`}>
          {part.map((item) => {
            const mediaArray: string[] = JSON.parse(item.media);
            const firstImage = mediaArray.length > 0 ? mediaArray[0] : "";
            return (
              <div class="relative py-4">
                <a href={`/${locale !== "en" ? `${locale}/` : ""}portfolio/${item.slug}`} class="group block">
                  <img
                    class="aspect-[0.75] w-full rounded-sm object-cover transition-opacity duration-500 group-hover:opacity-40"
                    src={`/assets/portfolio/${firstImage}`}
                    alt={item.title}
                  />
                  <p class="absolute left-1/2 top-1/2 z-50 -translate-x-1/2 -translate-y-1/2 text-center text-3xl font-bold opacity-0 transition-all duration-700 group-hover:scale-[2.5] group-hover:opacity-100">
                    {item.title}
                  </p>
                </a>
              </div>
            );
          })}
        </div>
      );
    })
  }
</section>

<style>
  /* .column-reverse {
    transform: translateY(calc(1px - 80%));
  } */
  @keyframes adjust-position {
    from {
      transform: translateY(-110%);
    }

    to {
      transform: translateY(120%);
    }
  }

  .column-reverse {
    animation: adjust-position linear forwards;
    animation-timeline: view();
  }
</style>
<script defer is:inline src="https://flackr.github.io/scroll-timeline/dist/scroll-timeline.js"></script>
