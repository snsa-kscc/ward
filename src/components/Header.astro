---
import { db } from "db";
import { eq, and } from "drizzle-orm";
import { pages } from "db/schema";

type Props = {
  lang: string;
  id?: string;
  slug?: string;
  links?: string;
};

const { lang, id, slug, links } = Astro.props;
const anotherLocale = lang === "hr" ? "en" : "hr";
let anotherSlug;

if (slug) {
  const res = await db
    .select({
      name: pages.name,
    })
    .from(pages)
    .where(and(eq(pages.slug, slug), eq(pages.lang, lang)));
  anotherSlug = await db
    .select({
      slug: pages.slug,
    })
    .from(pages)
    .where(and(eq(pages.name, res[0].name!), eq(pages.lang, anotherLocale)));
}

let href: string;

switch (true) {
  case !!id:
    href = `/${anotherLocale !== "en" ? `${anotherLocale}/` : ""}portfolio/${id}`;
    break;
  case !!slug:
    href = `/${anotherLocale !== "en" ? `${anotherLocale}/` : ""}${anotherSlug?.[0].slug}`;
    break;
  default:
    href = `/${anotherLocale !== "en" ? `${anotherLocale}` : ""}`;
}

const linksArray = links?.split(",").map((link) => link.trim());

function capitalizeLink(str: string) {
  return str.charAt(0).toUpperCase() + str.slice(1);
}
---

<header
  class="pointer-events-none fixed top-0 z-50 w-full -translate-y-full bg-linear-to-b from-zinc-900 opacity-0 backdrop-blur-sm transition-all duration-500"
>
  <div
    class="container flex items-center justify-between px-4 py-6 text-[clamp(var(--text-base),var(--text-lg))]"
  >
    <div class="hidden sm:block">
      <a href={lang === "hr" ? "/hr" : "/"} class="text-xl font-bold">WARD</a>
    </div>
    <div class="font-bold">
      <span
        class="flex h-14 w-14 items-center justify-center rounded-full border-2 border-slate-100 p-4"
      >
        <a href={href} class="text-lg">{anotherLocale.toUpperCase()}</a>
      </span>
    </div>
    <div>
      {
        linksArray?.map((link) => (
          <a
            href={lang === "hr" ? `/${lang}/#${link}` : `/#${link}`}
            class="ml-4 font-bold"
          >
            {capitalizeLink(link.replaceAll("-", " "))}
          </a>
        ))
      }
    </div>
  </div>
</header>

<script>
  const header = document.querySelector("header") as HTMLElement;

  window.addEventListener("scroll", () => {
    if (window.scrollY > window.innerHeight) {
      header.classList.remove(
        "opacity-0",
        "-translate-y-full",
        "pointer-events-none"
      );
      header.classList.add(
        "opacity-100",
        "translate-y-0",
        "pointer-events-auto"
      );
    } else {
      header.classList.add(
        "opacity-0",
        "-translate-y-full",
        "pointer-events-none"
      );
      header.classList.remove(
        "opacity-100",
        "translate-y-0",
        "pointer-events-auto"
      );
    }
  });
</script>
