---
import type { StoreData } from "@/types/global";

type Props = {
  clientsData: {
    id: number;
    createdAt: Date;
    item: string | null;
  }[];
  storeDataMap: StoreData;
};

const { clientsData, storeDataMap } = Astro.props;
const halfLength = Math.ceil(clientsData.length / 2);
const firstHalf = clientsData.slice(0, halfLength);
const secondHalf = clientsData.slice(halfLength);

const clientsKeyLines = storeDataMap.clientsKey
  .split(/\r?\n/)
  .filter((line) => line.trim());
---

<section
  class="relative container flex flex-col items-start gap-20 border-t border-b border-stone-200 px-6 py-[clamp(40,62)] md:flex-row"
>
  <div class="clients-key-wrapper basis-1/3">
    {
      clientsKeyLines.map((line, index) => (
        <p
          class={
            index === 0
              ? "text-2xl leading-tight font-medium"
              : "text-2xl leading-tight font-medium opacity-30"
          }
        >
          {line}
        </p>
      ))
    }
  </div>

  <div
    class="clients-content basis-2/3 text-[clamp(var(--text-lg),var(--text-xl))] leading-relaxed font-medium"
  >
    <div class="flex justify-around gap-14">
      <div class="clients-col clients-col-1">
        {
          firstHalf.map((item) => {
            return (
              <p class="clients-item mb-2 opacity-20 last:mb-0 md:mb-1">
                {item.item}
              </p>
            );
          })
        }
      </div>
      <div class="clients-col clients-col-2">
        {
          secondHalf.map((item) => {
            return (
              <p class="clients-item mb-2 opacity-20 last:mb-0 md:mb-1">
                {item.item}
              </p>
            );
          })
        }
      </div>
    </div>
  </div>
</section>

<style>
  .clients-key-wrapper {
    color: rgb(var(--color-stone-950));
  }

  .clients-content {
    color: rgb(var(--color-stone-950));
  }
</style>

<script>
  import gsap from "gsap";
  import ScrollTrigger from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  const clientsSection = document.querySelector(
    ".clients-content"
  ) as HTMLElement;
  const clientsCol1Items = document.querySelectorAll(
    ".clients-col-1 .clients-item"
  ) as NodeListOf<HTMLElement>;
  const clientsCol2Items = document.querySelectorAll(
    ".clients-col-2 .clients-item"
  ) as NodeListOf<HTMLElement>;

  if (clientsSection && (clientsCol1Items.length || clientsCol2Items.length)) {
    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: clientsSection,
        start: "top 80%",
        end: "bottom 40%",
        scrub: 1,
      },
    });

    if (clientsCol1Items.length) {
      tl.to(clientsCol1Items, {
        opacity: 1,
        stagger: 0.04,
      });
    }

    if (clientsCol2Items.length) {
      tl.to(
        clientsCol2Items,
        {
          opacity: 1,
          stagger: 0.04,
        },
        clientsCol1Items.length ? 0.15 : 0
      );
    }
  }
</script>
