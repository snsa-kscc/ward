---
type Props = {
  accoladesData: {
    id: number;
    createdAt: Date;
    item: string | null;
  }[];
  storeDataMap: {
    projects: string;
    ctaHook: string;
    ctaButton: string;
  };
};

const { accoladesData, storeDataMap } = Astro.props;
const halfLength = Math.ceil(accoladesData.length / 2);
const firstHalf = accoladesData.slice(0, halfLength);
const secondHalf = accoladesData.slice(halfLength);
---

<>
  <div class="container px-4 py-20">
    <div class="mb-20 font-bold leading-tight ~lg:~text-xl/5xl"></div>
    <div class="py-20"></div>
    <div class="font-bold leading-tight ~text-xl/5xl">
      {storeDataMap.projects}
    </div>
    <div class="my-40 flex items-center justify-between gap-4">
      <div class="bar-char-wrapper w-1/3 font-bold ~text-xl/5xl">
        {
          storeDataMap.ctaHook
            .split(/(\s)/)
            .map((word) => (
              <div class="word-wrapper inline-block">
                {word === " " ? (
                  <span class="bar-char inline-block">&nbsp;</span>
                ) : (
                  word.split("").map((char) => <span class="bar-char inline-block">{char}</span>)
                )}
              </div>
            ))
        }
      </div>
      <button class="rounded-full bg-wardGreen font-bold text-slate-100 duration-300 ~text-xl/2xl ~px-10/16 ~py-2/6 hover:bg-wardBlue">
        {storeDataMap.ctaButton}
      </button>
    </div>
  </div>
  <div class="container flex flex-col gap-16 p-8 font-bold ~lg:~text-xl/2xl lg:flex-row">
    <div>
      {
        firstHalf.map((item) => {
          return <p class="mb-8">{item.item}</p>;
        })
      }
    </div>
    <div class="mt-40">
      {
        secondHalf.map((item) => {
          return <p class="mb-8">{item.item}</p>;
        })
      }
    </div>
  </div>
</>

<style>
  .bar-char {
    will-change: filter, transform;
  }
</style>

<script>
  const barChars = document.querySelectorAll(".bar-char") as NodeListOf<HTMLElement>;
  gsap.fromTo(
    barChars,
    {
      scaleY: 0.1,
      scaleX: 1.8,
      filter: "blur(10px) brightness(50%)",
    },
    {
      ease: "power1.out",
      scaleY: 1,
      scaleX: 1,
      filter: "blur(0px) brightness(100%)",
      stagger: 0.05,
      scrollTrigger: {
        trigger: ".bar-char-wrapper",
        start: "top 80%",
        end: "top center",
        scrub: 1,
      },
    }
  );
</script>
