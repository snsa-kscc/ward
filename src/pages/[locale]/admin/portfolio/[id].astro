---
import Layout from "@/layouts/Layout.astro";
import AdminNavbar from "@/components/AdminNavbar.astro";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import { Textarea } from "@/components/ui/textarea";
import MediaTable from "@/components/MediaTable";
import { writeFile } from "fs/promises";
import path from "path";
import { db } from "db";
import { eq } from "drizzle-orm";
import { portfolio } from "db/schema";
import { slugify } from "@/lib/utils";

const { locale, id } = Astro.params;
const res = await db.select().from(portfolio).where(eq(portfolio.slug, id!));

if (!res[0]) {
  return Astro.redirect(`/${locale}/admin/portfolio/new`);
}

let filenames: string[] = JSON.parse(res[0].media as string);
let contentObject: Record<string, string> = JSON.parse(
  res[0].content as string
);
let slug;

if (Astro.request.method === "POST") {
  try {
    const res = await db
      .select()
      .from(portfolio)
      .where(eq(portfolio.slug, id!));
    filenames = JSON.parse(res[0].media as string);
    const formData = await Astro.request.formData();
    const title = formData.get("title") as string;
    const content = formData.get("content") as string;
    const mediaOrder = formData.get("media_order") as string;

    // Use the reordered filenames if available, otherwise keep original order
    if (mediaOrder) {
      filenames = JSON.parse(mediaOrder);
    }

    slug = slugify(title);
    let additionalFilenames: string[] = [];
    for (const file of formData.getAll("file") as File[]) {
      if (file.name) {
        const buffer = Buffer.from(await file.arrayBuffer());
        await writeFile(
          path.join("./public/assets/portfolio", file.name),
          buffer
        );
        additionalFilenames.push(file.name);
      }
    }
    filenames.unshift(...additionalFilenames);

    contentObject[locale!] = content;

    await db
      .update(portfolio)
      .set({
        title,
        slug,
        content: JSON.stringify(contentObject),
        media: JSON.stringify(filenames),
      })
      .where(eq(portfolio.slug, id!));
  } catch (error) {
    console.error("Error updating data:", error);
    return Astro.redirect(`/${locale}/admin/portfolio/${slug}?update=error`);
  }

  return Astro.redirect(`/${locale}/admin/portfolio/${slug}?update=success`);
}

const currentLocaleContent = contentObject[locale!];
---

<Layout lang={locale} title={res[0].title!}>
  <AdminNavbar lang={locale!} />
  <div class="container p-8">
    <h1 class="title py-20 text-3xl">{res[0].title}</h1>
    <form
      method="POST"
      enctype="multipart/form-data"
      class="flex flex-col items-start gap-4"
    >
      <Label htmlFor="title">title</Label>
      <Input
        type="text"
        name="title"
        required
        className="bg-transparent text-white"
        defaultValue={res[0].title as string}
      />
      <Label htmlFor="file">media</Label>
      <Input
        type="file"
        name="file"
        multiple
        accept="image/*, video/*"
        className="text-black"
      />
      <MediaTable client:load filenames={filenames} title={res[0].title!} />
      <Label htmlFor="content">description</Label>
      <Textarea
        name="content"
        className="bg-transparent text-white"
        defaultValue={currentLocaleContent}
        rows={15}
      />
      <Button type="submit" variant="secondary">send</Button>
    </form>
  </div>
  <script>
    import { toast } from "@/hooks/use-toast";

    const urlParams = new URLSearchParams(window.location.search);
    const updateStatus = urlParams.get("update");

    if (updateStatus === "success") {
      toast({
        title: "Success",
        description: "Update successful!",
      });
    } else if (updateStatus === "error") {
      toast({
        title: "Error",
        description: "Update failed.",
        variant: "destructive",
      });
    }
  </script>
</Layout>
