---
import Layout from "@/layouts/Layout.astro";
import AdminNavbar from "@/components/admin/AdminNavbar.astro";
import { db } from "db";
import { specialities } from "db/schema";
import { asc, eq } from "drizzle-orm";
import SpecialitiesManager from "@/components/admin/SpecialitiesManager";

const { locale } = Astro.params;

const specialitiesData = await db
  .select()
  .from(specialities)
  .where(eq(specialities.lang, locale!))
  .orderBy(asc(specialities.order));

const items = specialitiesData.map((item) => ({
  id: item.id,
  item: item.item ?? "",
  media: item.media ?? null,
}));
---

<Layout lang={locale} title="Specialities Management">
  <AdminNavbar lang={locale!} />
  <div class="container px-8">
    <h1 class="title py-20 text-3xl">Specialities Management</h1>
    <SpecialitiesManager client:only="react" items={items} locale={locale!} />
  </div>
  <script>
    import { toast } from "@/hooks/use-toast";

    const urlParams = new URLSearchParams(window.location.search);
    const updateStatus = urlParams.get("update");
    const errorType = urlParams.get("error");

    const getErrorMessage = (error: string | null) => {
      switch (error) {
        case "create_failed":
          return "Failed to create specialities.";
        case "reorder_failed":
          return "Failed to reorder specialities.";
        case "update_failed":
          return "Failed to update specialities.";
        case "unknown_error":
        default:
          return "An unknown error occurred.";
      }
    };

    if (updateStatus === "success") {
      toast({
        title: "Success",
        description: "Update successful!",
      });
    } else if (updateStatus === "error") {
      toast({
        title: "Error",
        description: getErrorMessage(errorType),
        variant: "destructive",
      });
    }
  </script>
</Layout>
