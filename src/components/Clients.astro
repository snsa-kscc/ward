---
import type { StoreData } from "@/types/global";

type Props = {
  clientsData: {
    id: number;
    createdAt: Date;
    item: string | null;
  }[];
  storeDataMap: StoreData;
};

const { clientsData, storeDataMap } = Astro.props;
const halfLength = Math.ceil(clientsData.length / 2);
const firstHalf = clientsData.slice(0, halfLength);
const secondHalf = clientsData.slice(halfLength);

const clientsKeyLines = storeDataMap.clientsKey
  .split(/\r?\n/)
  .filter((line) => line.trim());
---

<section
  class="relative container flex items-start gap-20 border-t border-b border-stone-200 px-4 py-[clamp(40,62)]"
>
  <div class="clients-key-wrapper basis-1/3">
    {
      clientsKeyLines.map((line, index) => (
        <p
          class={
            index === 0
              ? "text-2xl leading-tight font-medium"
              : "text-2xl leading-tight font-medium opacity-30"
          }
        >
          {line}
        </p>
      ))
    }
  </div>

  <div
    class="clients-content basis-2/3 text-[clamp(var(--text-lg),var(--text-xl))] leading-relaxed font-medium"
  >
    <div class="flex flex-col justify-around gap-14 lg:flex-row">
      <div>
        {
          firstHalf.map((item) => {
            return <p>{item.item}</p>;
          })
        }
      </div>
      <div>
        {
          secondHalf.map((item) => {
            return <p>{item.item}</p>;
          })
        }
      </div>
    </div>
  </div>
</section>

<style>
  .clients-key-wrapper {
    color: rgb(var(--color-stone-950));
  }

  .clients-content {
    color: rgb(var(--color-stone-950));
  }
</style>

<script>
  import gsap from "gsap";
  import { isInViewport } from "@/lib/utils";

  window.addEventListener(
    "scroll",
    () => {
      const projects = document.querySelector("[data-projects]");
      if (projects && isInViewport(projects)) {
        projects.classList.add(
          "animate-in",
          "fade-in",
          "opacity-100",
          "slide-in-from-bottom",
          "duration-300"
        );
      }
    },
    { passive: true }
  );
</script>
