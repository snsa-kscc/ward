---
import type { StoreData } from "@/types/global";

type Props = {
  awardsData: {
    id: number;
    createdAt: Date;
    item: string | null;
  }[];
  storeDataMap: StoreData;
};

const { awardsData, storeDataMap } = Astro.props;

const awardsKeyLines = storeDataMap.awardsKey
  .split(/\r?\n/)
  .filter((line) => line.trim());
---

<section
  class="relative container flex items-start gap-20 border-t border-b border-stone-200 px-4 py-[clamp(40,62)]"
>
  <div class="awards-key-wrapper basis-1/3 opacity-0" data-awards>
    {
      awardsKeyLines.map((line, index) => (
        <p
          class={
            index === 0
              ? "text-2xl leading-tight font-medium"
              : "text-2xl leading-tight font-medium opacity-30"
          }
        >
          {line}
        </p>
      ))
    }
  </div>

  <div
    class="awards-content basis-2/3 text-[clamp(var(--text-lg),var(--text-xl))] leading-relaxed font-medium"
  >
    <div>
      {
        awardsData.map((item) => {
          return <p class="mb-2 last:mb-0">{item.item}</p>;
        })
      }
    </div>
  </div>
</section>

<style>
  .awards-key-wrapper {
    color: rgb(var(--color-stone-950));
  }

  .awards-content {
    color: rgb(var(--color-stone-950));
  }
</style>

<script>
  import gsap from "gsap";
  import { isInViewport } from "@/lib/utils";

  window.addEventListener(
    "scroll",
    () => {
      const awards = document.querySelector("[data-awards]");
      if (awards && isInViewport(awards)) {
        awards.classList.add(
          "animate-in",
          "fade-in",
          "opacity-100",
          "slide-in-from-bottom",
          "duration-300"
        );
      }
    },
    { passive: true }
  );
</script>
