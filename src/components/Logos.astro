---
import { Image } from "astro:assets";

type Props = {
  data: {
    logo: string | null;
  }[];
};

const { data } = Astro.props;
---

<section
  class="my-[clamp(80,120)] flex gap-20 overflow-hidden py-[clamp(16,24)] lg:gap-36"
>
  {
    Array.from({ length: 4 }).map(() => (
      <div class="marquee-scroll flex shrink-0 justify-around gap-20 will-change-transform lg:gap-36">
        {data.map((brand) => (
          <div class="flex items-center">
            <Image
              class="w-[clamp(24,100)]"
              src={`/assets/brands/${brand.logo}`}
              alt={brand.logo?.split(".")[0] || ""}
              width={400}
              height={225}
            />
          </div>
        ))}
      </div>
    ))
  }
</section>

<style>
  @keyframes scroll {
    from {
      transform: translateX(0);
    }

    to {
      transform: translateX(calc(-100% - 5rem));
    }
  }

  @media (min-width: 1024px) {
    @keyframes scroll {
      from {
        transform: translateX(0);
      }

      to {
        transform: translateX(calc(-100% - 9rem));
      }
    }
  }

  .marquee-scroll {
    animation: scroll 40s linear infinite;
    transform: translateZ(0);
  }
</style>
