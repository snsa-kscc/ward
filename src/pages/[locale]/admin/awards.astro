---
import Layout from "@/layouts/Layout.astro";
import AdminNavbar from "@/components/admin/AdminNavbar.astro";
import { db } from "db";
import { awards } from "db/schema";
import { asc, eq } from "drizzle-orm";
import AwardsManager from "@/components/admin/AwardsManager";
import { defaultLocale } from "@/lib/utils";

const { locale } = Astro.params;

const awardsData = await db
  .select()
  .from(awards)
  .where(eq(awards.lang, defaultLocale))
  .orderBy(asc(awards.order));
const items = awardsData.map((item) => ({
  id: item.id,
  item: item.item!,
}));
---

<Layout lang={locale} title="Awards Management">
  <AdminNavbar lang={locale!} />
  <div class="container px-8">
    <h1 class="title py-20 text-3xl">Awards Management</h1>
    <AwardsManager client:only="react" items={items} locale={defaultLocale} />
  </div>
  <script>
    import { toast } from "@/hooks/use-toast";

    const urlParams = new URLSearchParams(window.location.search);
    const updateStatus = urlParams.get("update");

    if (updateStatus === "success") {
      toast({
        title: "Success",
        description: "Update successful!",
      });
    } else if (updateStatus === "error") {
      toast({
        title: "Error",
        description: "Update failed.",
        variant: "destructive",
      });
    }
  </script>
</Layout>
