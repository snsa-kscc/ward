---
import Layout from "@/layouts/Layout.astro";
import AdminNavbar from "@/components/AdminNavbar.astro";
import { Button } from "@/components/ui/button";
import { Label } from "@/components/ui/label";
import { Textarea } from "@/components/ui/textarea";
import { db } from "db";
import { accolades } from "db/schema";
import { max } from "drizzle-orm";

const { locale } = Astro.params;

if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();
  const item = formData.get("item") as string;

  const maxOrderResult = await db
    .select({ maxOrder: max(accolades.order) })
    .from(accolades);
  const newOrder = (maxOrderResult[0]?.maxOrder ?? 0) + 1;

  try {
    const res = await db
      .insert(accolades)
      .values({ item, createdAt: new Date(), lang: locale, order: newOrder });
    return Astro.redirect(
      `/${locale}/admin/accolades/${res[0].insertId}?update=success`
    );
  } catch (error) {
    console.error(error);
    return Astro.redirect(`/${locale}/admin/accolades/new?update=error`);
  }
}
---

<Layout lang={locale} title="New accolade">
  <AdminNavbar lang={locale!} />
  <div class="container px-8">
    <h1 class="title py-20 text-3xl">New accolade</h1>
    <form method="POST" class="flex flex-col items-start gap-4">
      <Label htmlFor="item">Accolade</Label>
      <Textarea
        name="item"
        className="bg-transparent text-white"
        required
        rows={10}
      />
      <Button type="submit" variant="secondary">send</Button>
    </form>
  </div>
  <script>
    import { toast } from "@/hooks/use-toast";

    const urlParams = new URLSearchParams(window.location.search);
    const updateStatus = urlParams.get("update");

    if (updateStatus === "success") {
      toast({
        title: "Success",
        description: "Update successful!",
      });
    } else if (updateStatus === "error") {
      toast({
        title: "Error",
        description: "Update failed.",
        variant: "destructive",
      });
    }
  </script>
</Layout>
