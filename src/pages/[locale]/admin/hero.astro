---
import Layout from "@/layouts/Layout.astro";
import AdminNavbar from "@/components/admin/AdminNavbar.astro";
import { Label } from "@/components/ui/label";
import { Input } from "@/components/ui/input";
import { Button } from "@/components/ui/button";
import { Textarea } from "@/components/ui/textarea";
import { upsertStoreData } from "@/lib/store";
import { db } from "db";
import { store } from "db/schema";
import { eq, and } from "drizzle-orm";

const { locale } = Astro.params;

const res = await db
  .select()
  .from(store)
  .where(and(eq(store.section, "hero"), eq(store.lang, locale!)));

const dict = res.reduce(
  (acc, cur) => {
    acc[cur.key as string] = cur.value as string;
    return acc;
  },
  {} as Record<string, string>,
);

if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();
  const result = await upsertStoreData({
    formData,
    section: "hero",
    locale: locale!,
    fileKeys: ["featureMedia", "reelMedia"],
  });

  if (result.success) {
    return Astro.redirect(`/${locale}/admin/hero?update=success`);
  } else {
    return Astro.redirect(`/${locale}/admin/hero?update=error`);
  }
}
---

<Layout lang={locale} title="Hero">
  <AdminNavbar lang={locale!} />
  <div class="container p-8">
    <h1 class="title py-20 text-3xl">Hero</h1>
    <form
      method="POST"
      enctype="multipart/form-data"
      class="flex flex-col items-start gap-4"
    >
      <Label htmlFor="navbarLinks">Navbar links</Label>
      <Input
        type="text"
        name="navbarLinks"
        required
        className="bg-transparent text-white"
        defaultValue={dict.navbarLinks}
      />
      <Label htmlFor="title">Title - (__) for line break</Label>
      <Input
        type="text"
        name="title"
        required
        className="bg-transparent text-white"
        defaultValue={dict.title}
      />
      <Label htmlFor="aboutKey">About key</Label>
      <Textarea
        name="aboutKey"
        className="bg-transparent text-white"
        rows={5}
        defaultValue={dict.aboutKey}
      />
      <Label htmlFor="about">About</Label>
      <Textarea
        name="about"
        className="bg-transparent text-white"
        rows={5}
        defaultValue={dict.about}
      />
      <Label htmlFor="capabilitiesKey">Capabilities key</Label>
      <Textarea
        name="capabilitiesKey"
        className="bg-transparent text-white"
        rows={5}
        defaultValue={dict.capabilitiesKey}
      />
      <Label htmlFor="capabilities">Capabilities - (__) for line break</Label>
      <Textarea
        name="capabilities"
        className="bg-transparent text-white"
        rows={5}
        defaultValue={dict.capabilities}
      />
      <Label htmlFor="capabilitiesDescription">Capabilities description</Label>
      <Textarea
        name="capabilitiesDescription"
        className="bg-transparent text-white"
        rows={5}
        defaultValue={dict.capabilitiesDescription}
      />
      <div class="flex w-full flex-col items-center gap-4 md:flex-row">
        <Label htmlFor="workKey">Work Key</Label>
        <Input
          type="text"
          name="workKey"
          className="w-full bg-transparent text-white"
          defaultValue={dict.workKey}
        />
        <Label htmlFor="dragKey">Drag Key</Label>
        <Input
          type="text"
          name="dragKey"
          className="w-full bg-transparent text-white"
          defaultValue={dict.dragKey}
        />
      </div>
      {
        dict.featureMedia && (
          <div class="flex items-center gap-4 px-6 py-2">
            <p>{dict.featureMedia}</p>
            <Button className="btn" variant="destructive">
              delete
            </Button>
          </div>
        )
      }
      <Label htmlFor="featureMedia">Feature Media</Label>
      <Input
        type="file"
        name="featureMedia"
        className="text-black"
        disabled={dict.featureMedia ? true : false}
      />
      {
        dict.reelMedia && (
          <div class="flex items-center gap-4 px-6 py-2">
            <p>{dict.reelMedia}</p>
            <Button className="btn" variant="destructive">
              delete
            </Button>
          </div>
        )
      }
      <Label htmlFor="reelMedia">Reel Media</Label>
      <Input
        type="file"
        name="reelMedia"
        className="text-black"
        disabled={dict.reelMedia ? true : false}
      />
      <Button type="submit" variant="secondary">send</Button>
    </form>
  </div>
  <script>
    import { toast } from "@/hooks/use-toast";
    import { actions } from "astro:actions";

    const urlParams = new URLSearchParams(window.location.search);
    const updateStatus = urlParams.get("update");

    if (updateStatus === "success") {
      toast({
        title: "Success",
        description: "Update successful!",
      });
    } else if (updateStatus === "error") {
      toast({
        title: "Error",
        description: "Update failed.",
        variant: "destructive",
      });
    }

    const buttons = document.querySelectorAll(
      ".btn",
    ) as NodeListOf<HTMLButtonElement>;

    buttons.forEach((button) => {
      if (button) {
        button.addEventListener("click", async (e) => {
          e.preventDefault();
          const result = await actions.deleteMedia({
            title: button.previousElementSibling?.textContent ?? "",
          });
          if (result.data === "deleted") {
            // Find the parent div, then look for the next label and its associated input
            const mediaDiv = button.parentElement;
            const nextLabel = mediaDiv?.nextElementSibling as HTMLLabelElement;
            const fileInput = nextLabel?.nextElementSibling as HTMLInputElement;

            button.parentElement?.remove();
            if (fileInput && fileInput.type === "file") {
              fileInput.disabled = false;
            }
          }
        });
      }
    });
  </script>
</Layout>
