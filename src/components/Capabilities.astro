---
import type { StoreData } from "@/types/global";

type Props = {
  data: StoreData;
};

const { data } = Astro.props;

// Split capabilitiesKey on line breaks - first line normal, rest with opacity
const capabilitiesKeyLines = data.capabilitiesKey
  .split(/\r?\n/)
  .filter((line) => line.trim());

// Split capabilities heading on __ delimiter for slide-up animation
const capabilitiesHeadingLines = data.capabilities
  .split("__")
  .map((line) => line.trim());

// Split capabilities text into words
const capabilitiesWords = data.capabilitiesDescription
  .split(/\s+/)
  .filter((word) => word.trim());
---

<section class="relative container px-6 py-[clamp(32,62)]">
  <div class="mb-[clamp(32,62)] w-full text-left">
    <h2
      class="cap-heading text-[clamp(var(--text-7xl),var(--text-10xl))] leading-[0.9] font-medium tracking-tight sm:leading-[0.8]"
    >
      {
        capabilitiesHeadingLines.map((line, index) => (
          <div
            class="cap-heading-wrapper -mb-4 overflow-hidden pb-4"
            data-line={index}
          >
            <div class="cap-heading-line">{line}</div>
          </div>
        ))
      }
    </h2>
  </div>
  <div
    class="flex flex-col items-start gap-20 border-t border-b border-stone-200 py-[clamp(32,62)] md:flex-row"
  >
    <div class="capabilities-key-wrapper basis-1/3">
      {
        capabilitiesKeyLines.map((line, index) => (
          <p
            class={
              index === 0
                ? "text-2xl leading-tight font-medium"
                : "text-2xl leading-tight font-medium opacity-30"
            }
          >
            {line}
          </p>
        ))
      }
    </div>

    <div
      class="capabilities-content basis-2/3 text-[clamp(var(--text-lg),var(--text-2xl))] leading-relaxed font-medium"
    >
      {
        capabilitiesWords.map((word) => (
          <span class="capabilities-word inline opacity-20">{word} </span>
        ))
      }
    </div>
  </div>
</section>

<style>
  .capabilities-key-wrapper {
    color: rgb(var(--color-stone-950));
  }

  .capabilities-content {
    color: rgb(var(--color-stone-950));
  }

  .cap-heading-wrapper {
    overflow: hidden;
    will-change: transform;
  }

  .cap-heading-line {
    will-change: transform;
    opacity: 0;
  }
</style>

<script>
  import gsap from "gsap";
  import ScrollTrigger from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  const capHeadingLines = document.querySelectorAll(
    ".cap-heading-line",
  ) as NodeListOf<HTMLElement>;

  if (capHeadingLines.length) {
    gsap.fromTo(
      capHeadingLines,
      { yPercent: 100, opacity: 0 },
      {
        duration: 1,
        yPercent: 0,
        opacity: 1,
        ease: "power2.out",
        stagger: 0.3,
        scrollTrigger: {
          trigger: ".cap-heading-wrapper",
          start: "top 80%",
          once: true,
        },
      },
    );
  }

  const capabilitiesSection = document.querySelector(
    ".capabilities-content",
  ) as HTMLElement;
  const capabilitiesWords = document.querySelectorAll(
    ".capabilities-word",
  ) as NodeListOf<HTMLElement>;

  gsap.to(capabilitiesWords, {
    opacity: 1,
    stagger: 0.05,
    scrollTrigger: {
      trigger: capabilitiesSection,
      start: "top 80%",
      end: "bottom 40%",
      scrub: 1,
    },
  });
</script>
