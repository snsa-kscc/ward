---
import { Image } from "astro:assets";

export type SpecialityItem = {
  id: number;
  item: string | null;
  media?: string | null;
};

type Props = {
  title?: string;
  items: SpecialityItem[];
};

const { title = "Specialities", items } = Astro.props as Props;
---

<section class="my-[clamp(40,72)]">
  <div class="container px-4 py-20">
    <h2
      class="text-[clamp(var(--text-xl),var(--text-5xl))] leading-tight font-bold"
    >
      {title}
    </h2>

    {
      items.length ? (
        <ol class="mt-12 space-y-6 text-[clamp(var(--text-lg),var(--text-2xl))] font-medium">
          {items.map((s) => (
            <li class="flex flex-col gap-3">
              {s.media ? (
                <Image
                  src={`/assets/specialities/${s.media}`}
                  alt={s.item ?? "Speciality"}
                  class="aspect-video w-full rounded-lg object-cover"
                  width={500}
                  height={500}
                  loading="lazy"
                />
              ) : null}
              <span>{s.item}</span>
            </li>
          ))}
        </ol>
      ) : (
        <p class="mt-12 opacity-70">No specialities yet.</p>
      )
    }
  </div>
</section>
