---
import Layout from "@/layouts/Layout.astro";
import Hero from "@/components/Hero.astro";
import About from "@/components/About.astro";
import Projects from "@/components/Projects.astro";
import Specialities from "@/components/Specialities.astro";
import Logos from "@/components/Logos.astro";
import Clients from "@/components/Clients.astro";
import Picture from "@/components/Picture.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { db } from "db";
import { asc, eq } from "drizzle-orm";
import { store, portfolio, brands, clients, pages } from "db/schema";
import { splitItems } from "@/lib/utils";
import type { StoreData, GridData } from "@/types/global";

const { locale } = Astro.params;

const [storeData, grid, brandsData, clientsData, pagesData] = await Promise.all(
  [
    db.select().from(store).where(eq(store.lang, locale!)),
    db.select().from(portfolio).orderBy(asc(portfolio.order)),
    db.select().from(brands).orderBy(asc(brands.order)),
    db
      .select()
      .from(clients)
      .where(eq(clients.lang, locale!))
      .orderBy(asc(clients.order)),
    db
      .select()
      .from(pages)
      .where(eq(pages.lang, locale!))
      .orderBy(asc(pages.name)),
  ]
);

const storeDataMap: StoreData = storeData.reduce((acc, cur) => {
  acc[cur.key as string] = cur.value as string;

  return acc;
}, {} as StoreData);

const gridData: GridData = splitItems(grid) as GridData;
---

<style>
  .loading-overlay {
    position: fixed;
    pointer-events: none;
    inset: 0;
    z-index: 100;
  }
  .loading-overlay.js-loaded {
    visibility: hidden;
    opacity: 0;
  }
</style>

<Layout
  lang={locale}
  title={storeDataMap.siteTitleFirst + " " + storeDataMap.siteTitleSecond}
  description={storeDataMap.about!}
>
  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const loadingOverlay = document.querySelector(".loading-overlay");
      loadingOverlay?.classList.add("js-loaded");
    });
    // if (window.scrollY === 0) {
    //   document.body.classList.add("overflow-hidden");
    //   setTimeout(() => {
    //     document.body.classList.remove("overflow-hidden");
    //   }, 4000);
    // }
  </script>
  <div class="loading-overlay bg-zinc-900"></div>
  <Header
    lang={locale!}
    links={storeDataMap.navbarLinks}
    pagesData={pagesData}
  />
  <Hero data={storeDataMap} />
  <Projects locale={locale!} data={gridData} storeDataMap={storeDataMap} />
  <About data={storeDataMap} />
  <Specialities data={storeDataMap} />
  <Logos data={brandsData} />
  <Clients clientsData={clientsData} storeDataMap={storeDataMap} />
  <Picture locale={locale!} />
  <Footer locale={locale!} storeData={storeDataMap} pagesData={pagesData} />
</Layout>
