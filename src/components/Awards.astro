---
import type { StoreData } from "@/types/global";

type Props = {
  awardsData: {
    id: number;
    createdAt: Date;
    item: string | null;
  }[];
  storeDataMap: StoreData;
};

const { awardsData, storeDataMap } = Astro.props;

const awardsKeyLines = storeDataMap.awardsKey
  .split(/\r?\n/)
  .filter((line) => line.trim());
---

<section class="px-6">
  <div
    class="relative container flex flex-col items-start gap-20 border-t border-b border-stone-200 py-[clamp(32,62)] md:flex-row"
  >
    <div class="awards-key-wrapper basis-1/3">
      {
        awardsKeyLines.map((line, index) => (
          <p
            class={
              index === 0
                ? "text-2xl leading-tight font-medium"
                : "text-2xl leading-tight font-medium opacity-30"
            }
          >
            {line}
          </p>
        ))
      }
    </div>

    <div
      class="awards-content basis-2/3 text-[clamp(var(--text-lg),var(--text-2xl))] leading-relaxed font-medium"
    >
      <div>
        {
          awardsData.map((item) => {
            return (
              <p class="awards-item mb-4 opacity-20 last:mb-0 md:mb-2">
                {item.item}
              </p>
            );
          })
        }
      </div>
    </div>
  </div>
</section>

<style>
  .awards-key-wrapper {
    color: rgb(var(--color-stone-950));
  }

  .awards-content {
    color: rgb(var(--color-stone-950));
  }
</style>

<script>
  import gsap from "gsap";
  import ScrollTrigger from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  const awardsSection = document.querySelector(
    ".awards-content"
  ) as HTMLElement;
  const awardsItems = document.querySelectorAll(
    ".awards-item"
  ) as NodeListOf<HTMLElement>;

  if (awardsSection && awardsItems.length) {
    gsap.to(awardsItems, {
      opacity: 1,
      stagger: 0.06,
      scrollTrigger: {
        trigger: awardsSection,
        start: "top 80%",
        end: "bottom 40%",
        scrub: 1,
      },
    });
  }
</script>
