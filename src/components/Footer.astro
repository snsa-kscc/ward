---
import { NewsletterSubscribe } from "./NewsletterSubscribe";
import type { StoreData } from "@/types/global";

type Props = {
  locale: string;
  storeData: StoreData;
  pagesData: {
    title: string | null;
    slug: string | null;
  }[];
};

const { locale, storeData, pagesData } = Astro.props;
---

<footer class="mt-[clamp(40,72)]">
  <div
    class="bar-char-wrapper container px-4 pb-[clamp(10,20)] text-[clamp(var(--text-3xl),var(--text-8xl))] font-bold"
  >
    {
      storeData.contactHook1.split("").map((char: string) => {
        if (char === " ") {
          return <span class="bar-char inline-block">&nbsp;</span>;
        }
        return <span class="bar-char inline-block">{char}</span>;
      })
    }
  </div>
  <div
    id={storeData.navbarLinks
      .split(",")
      .map((link) => link.trim())
      .at(-1)}
    class="footer-wrapper container px-4 pb-[clamp(10,20)] text-[clamp(var(--text-6xl),var(--text-14xl))] font-bold"
  >
    {
      storeData.contactHook2.split("").map((char: string) => {
        if (char === " ") {
          return <span class="cta-char inline-block">&nbsp;</span>;
        }
        return <span class="cta-char inline-block">{char}</span>;
      })
    }
  </div>
  <div class="container my-[clamp(10,20)] px-4">
    <div class="flex flex-col justify-between gap-16 sm:flex-row">
      <div class="flex basis-1/3 gap-16">
        <div class="basis-1/2">
          <p
            class="pb-8 text-[clamp(var(--text-xl),var(--text-2xl))] font-bold"
          >
            {storeData.contactKey}
          </p>
          <p>
            <a
              href={`mailto:${storeData.contactEmail}`}
              class="relative pb-0.5 transition-colors after:absolute after:bottom-0 after:left-0 after:h-0.5 after:w-0 after:bg-current after:transition-all after:duration-300 after:ease-in-out hover:after:w-full"
              >{storeData.contactEmail}</a
            >
          </p>
          <p>
            tel: <a
              href={`tel:${storeData.contactPhone.replaceAll(" ", "")}`}
              class="relative pb-0.5 transition-colors after:absolute after:bottom-0 after:left-0 after:h-0.5 after:w-0 after:bg-current after:transition-all after:duration-300 after:ease-in-out hover:after:w-full"
              >{storeData.contactPhone}</a
            >
          </p>
          <p>{storeData.contactAddress}</p>
        </div>
        <div class="basis-1/2">
          <p
            class="pb-8 text-[clamp(var(--text-xl),var(--text-2xl))] font-bold"
          >
            {storeData.infoKey}
          </p>
          {
            pagesData.map((page) => (
              <div class="">
                <a
                  href={`/${locale !== "en" ? `${locale}/` : ""}${page.slug}`}
                  class="relative pb-0.5 transition-colors after:absolute after:bottom-0 after:left-0 after:h-0.5 after:w-0 after:bg-current after:transition-all after:duration-300 after:ease-in-out hover:after:w-full"
                >
                  {page.title}
                </a>
              </div>
            ))
          }
        </div>
      </div>
      <div class="basis-1/3">
        <p class="pb-8 text-[clamp(var(--text-xl),var(--text-2xl))] font-bold">
          {storeData.newsletterKey}
        </p>
        <NewsletterSubscribe
          client:load
          button={storeData.newsletterButton}
          lang={locale}
        />
        <p class="pt-6 text-xs" set:html={storeData.newsletterDisclaimer} />
      </div>
    </div>
    <div
      class="pt-[clamp(10,40)] text-[clamp(var(--text-xl),var(--text-2xl))] font-bold"
    >
      <p>{`© ${new Date().getFullYear()} ${storeData.copyright}`}</p>
    </div>
  </div>
</footer>

<style>
  .bar-char {
    will-change: filter, transform;
  }
</style>

<script>
  import { gsap } from "gsap";
  import ScrollTrigger from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  function initFooterAnimation() {
    const footerChars = document.querySelectorAll(
      ".cta-char"
    ) as NodeListOf<HTMLElement>;
    const barChars = document.querySelectorAll(
      ".bar-char"
    ) as NodeListOf<HTMLElement>;

    if (!barChars.length && !footerChars.length) return;

    if (barChars.length) {
      gsap.fromTo(
        barChars,
        {
          scaleY: 0.1,
          scaleX: 1.8,
          filter: "blur(10px) brightness(50%)",
        },
        {
          ease: "power1.out",
          scaleY: 1,
          scaleX: 1,
          filter: "blur(0px) brightness(100%)",
          stagger: 0.05,
          scrollTrigger: {
            trigger: ".bar-char-wrapper",
            start: "top 80%",
            end: "top center",
            scrub: 1,
          },
        }
      );
    }

    if (footerChars.length) {
      gsap.fromTo(
        footerChars,
        {
          opacity: 0,
          skewX: -20,
          willChange: "filter, transform",
          filter: "blur(8px)",
        },
        {
          ease: "sine",
          opacity: 1,
          skewX: 0,
          filter: "blur(0px)",
          stagger: 0.04,
          scrollTrigger: {
            trigger: ".footer-wrapper",
            start: "top 80%",
            end: "top 40%",
            scrub: 1,
          },
        }
      );
    }
  }

  document.addEventListener("DOMContentLoaded", initFooterAnimation);
</script>
